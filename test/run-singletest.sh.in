#!/bin/sh

SSCM="@abs_top_builddir@/src/sscm --system-load-path @abs_top_srcdir@/lib"

case "$1" in
  /*) test_file="$1" ;;
  *)  test_file="@abs_top_builddir@/test/$1" ;;
esac

# test-srfi64.scm tests SRFI-64 itself. test-fail.scm and
# test-unittest.scm use lib/unittest.scm. All other tests use SRFI-64
# with helper.scm. It has the runner that makes the exit status non-zero
# on failure.
case "${test_file##*/}" in
  test-fail.scm|test-srfi64.scm|test-unittest.scm)
    ;;
  *)
    if test "@use_srfi64@" != yes; then
      echo "SKIP: SRFI-64 is not enabled"
      exit 77
    fi
    SSCM="$SSCM --load @abs_top_srcdir@/test/helper.scm"
    ;;
esac

cd @top_srcdir@ && $SSCM "$test_file"
