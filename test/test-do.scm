(require-extension (srfi 64))

(test-begin "test-do")


;;
;; do
;;
(test-begin "do invalid form")
(test-error (do))
(test-error (do v))
(test-error (do (v 1)))
(test-error (do ((v 1))
                ))
(test-error (do ((v))
                'eval))
(test-error (do ((v 1))
                'unknow-value))
(test-error (do ((v 1 2 'excessive))
                'eval))
(test-end "do invalid form")
(test-begin "do invalid form: no test")
(test-error (do ((v 1))
                ()
              'eval))
(test-end "do invalid form: no test")
(test-begin "do invalid form: non-list test form")
(test-error (do ((v 1))
                'test
              'eval))
(test-error (do ((v 1))
                1
              'eval))
(test-end "do invalid form: non-list test form")
(test-begin "do invalid form: non-list bindings form")
(test-error (do 'bindings
                (#t #t)
              'eval))
(test-error (do 1
                (#t #t)
              'eval))
(test-end "do invalid form: non-list bindings form")
(test-begin "do invalid form: non-symbol variable name")
(test-error (do ((1 1))
                (#t #t)
              #t))
(test-error (do ((#t 1))
                (#t #t)
              #t))
(test-error (do (("a" 1))
                (#t #t)
              #t))
(test-end "do invalid form: non-symbol variable name")
(test-begin "do invalid form: duplicate variable name")
(test-error (do ((v 1)
                 (v 2))
                (#t #t)
              #t))
(test-error (do ((v 1)
                 (w 0)
                 (v 2))
                (#t #t)
              #t))
(test-end "do invalid form: duplicate variable name")
(test-begin "do invalid form: improper binding")
(test-error (do ((v . 1))
                (#t #t)
              #t))
(test-error (do ((v  1 . v))
                (#t #t)
              #t))
(test-error (do ((v  1) . 1)
                (#t #t)
              #t))
(test-end "do invalid form: improper binding")
(test-begin "do invalid form: improper exps")
(test-error (do ((v  1))
                (#t . #t)
              #t))
(test-error (do ((v  1))
                (#t #t . #t)
              #t))
(test-end "do invalid form: improper exps")
(test-begin "do invalid form: improper commands")
(test-error (do ((v  1))
                (#t #t)
              #t . #t))
(test-error (do ((v  1 (+ v 1)))
                ((= v 2) #t)
              #t . #t))
(test-end "do invalid form: improper commands")
(test-begin "do invalid form: 'define' at <init>")
;; Since <init>s are evaled in toplevel env, these tests cause error only when
;; SCM_STRICT_TOPLEVEL_DEFINITIONS.
(if (provided? "strict-toplevel-definitions")
    (begin
      (test-error (eval '(do ((i (define var1 1)))
                             (#t #t)
                           )
                        (interaction-environment)))
      (test-error (eval '(do ((i (begin)))
                             (#t #t)
                           )
                        (interaction-environment)))
      (test-error (eval '(do ((i (begin (define var1 1))))
                             (#t #t)
                           )
                        (interaction-environment)))
      (test-error (eval '(do ((i (begin (define var1 1) 1)))
                             (#t #t)
                           )
                        (interaction-environment)))
      (test-error (eval '(do ((i (begin 1 (define var1 1))))
                             (#t #t)
                           )
                        (interaction-environment)))))
(test-end "do invalid form: 'define' at <init>")
(test-begin "do invalid form: 'define' at <step>")
(test-error (eval '(do ((i 0 (define var1 1)))
                       (#f #t)
                     )
                  (interaction-environment)))
(if (provided? "strict-toplevel-definitions")
    (test-error (eval '(do ((i 0 (begin)))
                           (#f #t)
                         )
                      (interaction-environment))))
(test-error (eval '(do ((i 0 (begin (define var1 1))))
                       (#f #t)
                     )
                  (interaction-environment)))
(test-error (eval '(do ((i 0 (begin (define var1 1) 1)))
                       (#f #t)
                     )
                  (interaction-environment)))
(test-error (eval '(do ((i 0 (begin 1 (define var1 1))))
                       (#f #t)
                     )
                  (interaction-environment)))
(test-end "do invalid form: 'define' at <step>")
(test-begin "do invalid form: 'define' at <expression>s")
(test-error (eval '(do ((i 0))
                       (#t (define var1 1))
                     )
                  (interaction-environment)))
(if (provided? "strict-toplevel-definitions")
    (test-error (eval '(do ((i 0))
                           (#t (begin))
                         )
                      (interaction-environment))))
(test-error (eval '(do ((i 0))
                       (#t (begin (define var1 1)))
                     )
                  (interaction-environment)))
(test-error (eval '(do ((i 0))
                       (#t (begin (define var1 1) 1))
                     )
                  (interaction-environment)))
(test-error (eval '(do ((i 0))
                       (#t (begin 1 (define var1 1)))
                     )
                  (interaction-environment)))
(test-end "do invalid form: 'define' at <expression>s")
(test-begin "do invalid form: 'define' at <command>s")
(test-error (eval '(do ((i 0 (+ i 1)))
                       ((= i 1) #t)
                     (define var1 1))
                  (interaction-environment)))
(if (provided? "strict-toplevel-definitions")
    (test-error (eval '(do ((i 0 (+ i 1)))
                           ((= i 1) #t)
                         (begin))
                      (interaction-environment))))
(test-error (eval '(do ((i 0 (+ i 1)))
                       ((= i 1) #t)
                     (begin
                       (define var1 1)))
                  (interaction-environment)))
(test-error (eval '(do ((i 0 (+ i 1)))
                       ((= i 1) #t)
                     (begin
                       (define var1 1)
                       1))
                  (interaction-environment)))
(test-error (eval '(do ((i 0 (+ i 1)))
                       ((= i 1) #t)
                     (begin
                       1
                       (define var1 1)))
                  (interaction-environment)))
(test-end "do invalid form: 'define' at <command>s")

(test-begin "do invalid form: binding syntactic keywords on <init>")
(test-error (do ((syn define))
                (#t #t)
              #t))
(test-error (do ((syn if))
                (#t #t)
              #t))
(test-error (do ((syn and))
                (#t #t)
              #t))
(test-error (do ((syn cond))
                (#t #t)
              #t))
(test-error (do ((syn begin))
                (#t #t)
              #t))
(test-error (do ((syn do))
                (#t #t)
              #t))
(test-error (do ((syn delay))
                (#t #t)
              #t))
(test-error (do ((syn let*))
                (#t #t)
              #t))
(test-error (do ((syn else))
                (#t #t)
              #t))
(test-error (do ((syn =>))
                (#t #t)
              #t))
(test-error (do ((syn quote))
                (#t #t)
              #t))
(test-error (do ((syn quasiquote))
                (#t #t)
              #t))
(test-error (do ((syn unquote))
                (#t #t)
              #t))
(test-error (do ((syn unquote-splicing))
                (#t #t)
              #t))
(test-end "do invalid form: binding syntactic keywords on <init>")

(test-begin "do invalid form: binding syntactic keywords on <step>")
(test-error (do ((syn #t define))
                (#f #t)
              #t))
(test-error (do ((syn #t if))
                (#f #t)
              #t))
(test-error (do ((syn #t and))
                (#f #t)
              #t))
(test-error (do ((syn #t cond))
                (#f #t)
              #t))
(test-error (do ((syn #t begin))
                (#f #t)
              #t))
(test-error (do ((syn #t do))
                (#f #t)
              #t))
(test-error (do ((syn #t delay))
                (#f #t)
              #t))
(test-error (do ((syn #t let*))
                (#f #t)
              #t))
(test-error (do ((syn #t else))
                (#f #t)
              #t))
(test-error (do ((syn #t =>))
                (#f #t)
              #t))
(test-error (do ((syn #t quote))
                (#f #t)
              #t))
(test-error (do ((syn #t quasiquote))
                (#f #t)
              #t))
(test-error (do ((syn #t unquote))
                (#f #t)
              #t))
(test-error (do ((syn #t unquote-splicing))
                (#f #t)
              #t))
(test-end "do invalid form: binding syntactic keywords on <step>")

(test-begin "do valid form: no bindings")
(test-assert (lambda ()
               (do ()
                   (#t #t)
                 'foo)))
(test-assert (lambda ()
               (do ()
                   (#t)
                 'foo)))
(test-assert (lambda ()
               (do ()
                   (#t #t)
                 )))
(test-assert (lambda ()
               (do ()
                   (#t)
                 )))
(test-end "do valid form: no bindings")
(test-begin "do valid form: no commands")
(test-assert (lambda ()
               (do ((v 1))
                   (#t #t)
                 )))
(test-assert (lambda ()
               (do ((v 1))
                   (#t)
                 )))
(test-end "do valid form: no commands")
(test-begin "do valid form: no exps")
(if (provided? "sigscheme")
    (test-equal (undef)
                (do ((v 1))
                    (#t)
                  'foo)))
(test-end "do valid form: no exps")

(test-begin "do inter-iteration variable isolation")
(test-equal '(2 1 0)
            (do ((v '() (cons i v))
                 (i 0 (+ i 1)))
                ((= i 3) v)
              ))
(test-equal '(2 1 0)
            (do ((i 0 (+ i 1))
                 (v '() (cons i v)))
                ((= i 3) v)
              ))
(test-end "do inter-iteration variable isolation")

(test-begin "do initialize-time variable isolation")
(test-error (do ((v 1)
                 (w v))
                (#t #t)
              ))
(test-error (do ((w v)
                 (v 1))
                (#t #t)
              ))
(test-end "do initialize-time variable isolation")

(test-begin "do exp is evaluated exactly once")
(test-equal '(+ v w)
            (do ((v 1)
                 (w 2))
                (#t '(+ v w))
              ))
(test-end "do exp is evaluated exactly once")

(test-begin "do iteration count")
(test-equal 0
            (do ((i 0 (+ i 1))
                 (evaled 0))
                (#t evaled)
              (set! evaled (+ evaled 1))))
(test-equal 0
            (do ((i 0 (+ i 1))
                 (evaled 0))
                ((= i 0) evaled)
              (set! evaled (+ evaled 1))))
(test-equal 1
            (do ((i 0 (+ i 1))
                 (evaled 0))
                ((= i 1) evaled)
              (set! evaled (+ evaled 1))))
(test-equal 2
            (do ((i 0 (+ i 1))
                 (evaled 0))
                ((= i 2) evaled)
              (set! evaled (+ evaled 1))))
(test-end "do iteration count")

(test-begin "do variable update")
(test-equal 10
            (do ((v 1)
                 (w 2))
                (#t (set! v (+ v 1))
                    (set! w (+ w v))
                    (set! v (+ v w))
                    (+ w v))
              ))
(test-equal 16
            (do ((i 0 (+ i 1))
                 (v 1)
                 (w 2))
                ((= i 1)
                 (set! v (+ v 1))
                 (set! w (+ w v))
                 (set! v (+ v w))
                 (+ w v))
              (set! v 3)))
(test-equal 20
            (do ((i 0 (+ i 1))
                 (v 1)
                 (w 2))
                ((= i 1)
                 (set! v (+ v 1))
                 (set! w (+ w v))
                 (set! v (+ v w))
                 (+ w v))
              (set! v 3)
              (set! w 4)))
(test-end "do variable update")

(test-begin "do per-iteration env isolation")
(test-equal '(4 3 2 1 0)
            (do ((i 0 (+ i 1))
                 (procs '() (cons (lambda () i) procs)))
                ((= i 5) (map (lambda (p) (p)) procs))
              ))
(test-equal '(8 6 4 2 0)
            (do ((i 0 (+ i 1))
                 (procs '() (cons (lambda ()
                                    (set! i (* i 2)) i)
                                  procs)))
                ((= i 5) (map (lambda (p) (p)) procs))
              ))
(test-equal '(4 3 2 1 0)
            (do ((i 0 (+ i 1))
                 (procs '() (cons (lambda () i) procs)))
                ((= i 5)
                 (set! i 1024)
                 (map (lambda (p) (p)) procs))
              ))

(test-equal "do test1" '#(0 1 2 3 4) (do ((vec (make-vector 5))
                                          (i 0 (+ i 1)))
                                         ((= i 5) vec)
                                       (vector-set! vec i i)))
(test-equal "do test2" 25 (let ((x '(1 3 5 7 9)))
                            (do ((x x (cdr x))
                                 (sum 0 (+ sum (car x))))
                                ((null? x) sum))))

(define (expt-do x n)
  (do ((i 0 (+ i 1))
       (y 1))
      ((= i n) y)
    (set! y (* x y))))
(test-equal "do test3" 1024 (expt-do 2 10))

(define (nreverse rev-it)
  (do ((reved '() rev-it)
       (rev-cdr (cdr rev-it) (cdr rev-cdr))
       (rev-it rev-it rev-cdr))
      ((begin
         (set-cdr! rev-it reved)
         (null? rev-cdr))
       rev-it)))
(test-equal "do test4" '(c b a) (nreverse (list 'a 'b 'c)))
(test-equal "do test5"
            '((5 6) (3 4) (1 2))
            (nreverse (list '(1 2) '(3 4) '(5 6))))

;; scm_s_do() has been changed as specified in R5RS. -- YamaKen 2006-01-11
;; R5RS: If no <expression>s are present, then the value of the `do' expression
;; is unspecified.
;;(test-equal "do test6" 1  (do ((a 1)) (a) 'some))
;;(test-equal "do test7" #t (do ((a 1)) (#t) 'some))
(if (provided? "sigscheme")
    (begin
      (test-equal "do test6" (undef) (do ((a 1)) (a) 'some))
      (test-equal "do test7" (undef) (do ((a 1)) (#t) 'some))))
;; (do ((a 1)) 'eval) => (do ((a 1)) (quote eval))
(test-equal "do test8" eval (do ((a 1)) 'eval))
(test-end "do per-iteration env isolation")


(test-end "test-do")
