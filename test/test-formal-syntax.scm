(require-extension (srfi 64))

(test-begin "test-formal-syntax")

;; See "7.1 Formal syntax" of R5RS
;; See also test-number-literal.scm

(test-begin "upper-case boolean")
(test-assert (boolean? (string-read "#F")))
(test-assert (boolean? (string-read "#T")))
(test-end "upper-case boolean")

(test-begin "boolean")
(test-assert (boolean? (string-read "#f")))
(test-assert (boolean? (string-read "#t")))
(test-end "boolean")

(test-begin "invalid identifier")
(test-error (string-read "#"))
(test-error (string-read "."))
(test-error (string-read ".."))
(test-error (string-read "...."))
(test-error (string-read ".a"))
(test-error (string-read "+a"))
(test-error (string-read "++"))
(test-error (string-read "--"))
(test-error (string-read "-="))
(test-error (string-read "-$"))
(test-error (string-read "-."))
(test-error (string-read "-@"))
(test-error (string-read "@"))
(test-error (string-read "1a"))
(test-error (string-read "-a"))
(test-end "invalid identifier")

(test-begin "special initial identifier")
(test-assert (symbol? (string-read "!")))
(test-assert (symbol? (string-read "$")))
(test-assert (symbol? (string-read "%")))
(test-assert (symbol? (string-read "&")))
(test-assert (symbol? (string-read "*")))
(test-assert (symbol? (string-read "/")))
(test-assert (symbol? (string-read ":")))
(test-assert (symbol? (string-read "<")))
(test-assert (symbol? (string-read "=")))
(test-assert (symbol? (string-read ">")))
(test-assert (symbol? (string-read "?")))
(test-assert (symbol? (string-read "^")))
(test-assert (symbol? (string-read "_")))
(test-assert (symbol? (string-read "~")))
(test-end "special initial identifier")

(test-begin "special initial identifier + number")
(test-assert (symbol? (string-read "!1")))
(test-assert (symbol? (string-read "$1")))
(test-assert (symbol? (string-read "%1")))
(test-assert (symbol? (string-read "&1")))
(test-assert (symbol? (string-read "*1")))
(test-assert (symbol? (string-read "/1")))
(test-assert (symbol? (string-read ":1")))
(test-assert (symbol? (string-read "<1")))
(test-assert (symbol? (string-read "=1")))
(test-assert (symbol? (string-read ">1")))
(test-assert (symbol? (string-read "?1")))
(test-assert (symbol? (string-read "^1")))
(test-assert (symbol? (string-read "_1")))
(test-assert (symbol? (string-read "~1")))
(test-end "special initial identifier + number")

(test-begin "special initial identifier + letter")
(test-assert (symbol? (string-read "!a")))
(test-assert (symbol? (string-read "$a")))
(test-assert (symbol? (string-read "%a")))
(test-assert (symbol? (string-read "&a")))
(test-assert (symbol? (string-read "*a")))
(test-assert (symbol? (string-read "/a")))
(test-assert (symbol? (string-read ":a")))
(test-assert (symbol? (string-read "<a")))
(test-assert (symbol? (string-read "=a")))
(test-assert (symbol? (string-read ">a")))
(test-assert (symbol? (string-read "?a")))
(test-assert (symbol? (string-read "^a")))
(test-assert (symbol? (string-read "_a")))
(test-assert (symbol? (string-read "~a")))
(test-end "special initial identifier + letter")

(test-begin "identifier")
(test-assert (symbol? (string-read "...")))
(test-assert (symbol? (string-read "+")))
(test-assert (symbol? (string-read "-")))
(test-assert (symbol? (string-read "a.")))
(test-assert (symbol? (string-read "a+")))
(test-assert (symbol? (string-read "a-")))
(test-assert (symbol? (string-read "a@")))
(test-assert (symbol? (string-read "a1")))
;; SigScheme 0.7.0 and later disallows initial hyphen of an identifier.
(if sigscheme?
    (begin
      (test-error (symbol? (string-read "-a")))
      (test-assert (symbol? (string->symbol "-a")))))
(test-end "identifier")

(test-begin "invalid dot pair")
(test-error (string-read "( . )"))
(test-error (string-read "( . \"foo\")"))
(test-error (string-read "( . \"foo\" \"bar\")"))
(test-error (string-read "(\"foo\" . )"))
(test-error (string-read "(\"foo\" \"bar\" . )"))
(test-error (string-read "(\"foo\" . \"bar\" \"baz\")"))
(test-error (string-read "(\"foo\" \"bar\" . \"baz\" \"quux\")"))
(test-end "invalid dot pair")

(test-begin "invalid dot pair without left space")
(test-error (string-read "(. )"))
(test-error (string-read "(. \"foo\")"))
(test-error (string-read "(. \"foo\" \"bar\")"))
(test-error (string-read "(\"foo\". )"))
(test-error (string-read "(\"foo\" \"bar\". )"))
(test-error (string-read "(\"foo\". \"bar\" \"baz\")"))
(test-error (string-read "(\"foo\" \"bar\". \"baz\" \"quux\")"))
(test-end "invalid dot pair without left space")

(test-begin "dot pair")
(test-assert (begin (string-read "(\"foo\" . \"bar\")") #t))
(test-assert (begin (string-read "(\"foo\" \"bar\" . \"baz\")") #t))
(test-end "dot pair")

(test-begin "dot pair without left space")
(test-assert (begin (string-read "(\"foo\". \"bar\")") #t))
(test-assert (begin (string-read "(\"foo\" \"bar\". \"baz\")") #t))
(test-end "dot pair without left space")

(test-begin "invalid dot pair without right space")
(test-error (string-read "( .)"))
(test-error (string-read "( .\"foo\")"))
(test-error (string-read "( .\"foo\" \"bar\")"))
(test-error (string-read "(\"foo\" .)"))
(test-error (string-read "(\"foo\" \"bar\" .)"))
(test-error (string-read "(\"foo\" .\"bar\" \"baz\")"))
(test-error (string-read "(\"foo\" \"bar\" .\"baz\" \"quux\")"))
(test-end "invalid dot pair without right space")

(test-begin "invalid dot pair without both space")
(test-error (string-read "(.)"))
(test-error (string-read "(.\"foo\")"))
(test-error (string-read "(.\"foo\" \"bar\")"))
(test-error (string-read "(\"foo\".)"))
(test-error (string-read "(\"foo\" \"bar\".)"))
(test-error (string-read "(\"foo\".\"bar\" \"baz\")"))
(test-error (string-read "(\"foo\" \"bar\".\"baz\" \"quux\")"))
(test-end "invalid dot pair without both space")

;; SigScheme requires explicit whitespace around the dot unless strict R5RS
;; mode to avoid compatibility problem with other implementations.
(let ((check (if (and (provided? "sigscheme")
                      (not (provided? "strict-r5rs")))
                 (lambda (str) (test-error (string-read str)))
                 (lambda (str) (test-assert (begin (string-read str) #t))))))
  (test-begin "dot pair without right space")
  (check "(\"foo\" .\"bar\")")
  (check "(\"foo\" \"bar\" .\"baz\")")
  (test-end "dot pair without right space")

  (test-begin "dot pair without both space")
  (check "(\"foo\".\"bar\")")
  (check "(\"foo\" \"bar\".\"baz\")")
  (test-end "dot pair without both space"))

(test-error "invalid function calling: boolean" #t (#t))
(test-error "invalid function calling: integer" #t (1))
(test-error "invalid function calling: null" #t ('()))
(test-error "invalid function calling: pair" #t ('(1 2)))
(test-error "invalid function calling: char" #t (#\a))
(test-error "invalid function calling: string" #t ("a"))
(test-error "invalid function calling: vector" #t (#(1)))

(test-begin "function calling fixed_0")
(define f (lambda () #t))
(test-equal #t         (f))
(test-error (f . #t))
(test-error (f #t))
(test-error (f #t . #t))
(test-error (f #t #t))
(test-error (f #t #t . #t))
(test-error (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling fixed_0")
(test-begin "function calling variadic_0")
(define f (lambda args args))
(test-equal '()         (f))
(test-error (f . #t))
(test-equal '(#t)       (f #t))
(test-error (f #t . #t))
(test-equal '(#t #t)    (f #t #t))
(test-error (f #t #t . #t))
(test-equal '(#t #t #t) (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling variadic_0")
(test-begin "function calling fixed_1")
(define f (lambda (x) x))
(test-error (f))
(test-error (f . #t))
(test-equal #t         (f #t))
(test-error (f #t . #t))
(test-error (f #t #t))
(test-error (f #t #t . #t))
(test-error (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling fixed_1")
(test-begin "function calling variadic_1")
(define f (lambda (x . rest) (list x rest)))
(test-error (f))
(test-error (f . #t))
(test-equal '(#t ())      (f #t))
(test-error (f #t . #t))
(test-equal '(#t (#t))    (f #t #t))
(test-error (f #t #t . #t))
(test-equal '(#t (#t #t)) (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling variadic_1")
(test-begin "function calling fixed_2")
(define f (lambda (x y) (list x y)))
(test-error (f))
(test-error (f . #t))
(test-error (f #t))
(test-error (f #t . #t))
(test-equal '(#t #t)      (f #t #t))
(test-error (f #t #t . #t))
(test-error (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling fixed_2")
(test-begin "function calling variadic_2")
(define f (lambda (x y . rest) (list x y rest)))
(test-error (f))
(test-error (f . #t))
(test-error (f #t))
(test-error (f #t . #t))
(test-equal '(#t #t ())   (f #t #t))
(test-error (f #t #t . #t))
(test-equal '(#t #t (#t)) (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling variadic_2")

(test-begin "function calling fixed_0 for define-created closure")
(define (f) #t)
(test-equal #t         (f))
(test-error (f . #t))
(test-error (f #t))
(test-error (f #t . #t))
(test-error (f #t #t))
(test-error (f #t #t . #t))
(test-error (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling fixed_0 for define-created closure")
(test-begin "function calling variadic_0 for define-created closure")
(define (f . args) args)
(test-equal '()         (f))
(test-error (f . #t))
(test-equal '(#t)       (f #t))
(test-error (f #t . #t))
(test-equal '(#t #t)    (f #t #t))
(test-error (f #t #t . #t))
(test-equal '(#t #t #t) (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling variadic_0 for define-created closure")
(test-begin "function calling fixed_1 for define-created closure")
(define (f x) x)
(test-error (f))
(test-error (f . #t))
(test-equal #t         (f #t))
(test-error (f #t . #t))
(test-error (f #t #t))
(test-error (f #t #t . #t))
(test-error (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling fixed_1 for define-created closure")
(test-begin "function calling variadic_1 for define-created closure")
(define (f x . rest) (list x rest))
(test-error (f))
(test-error (f . #t))
(test-equal '(#t ())      (f #t))
(test-error (f #t . #t))
(test-equal '(#t (#t))    (f #t #t))
(test-error (f #t #t . #t))
(test-equal '(#t (#t #t)) (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling variadic_1 for define-created closure")
(test-begin "function calling fixed_2 for define-created closure")
(define (f x y) (list x y))
(test-error (f))
(test-error (f . #t))
(test-error (f #t))
(test-error (f #t . #t))
(test-equal '(#t #t)      (f #t #t))
(test-error (f #t #t . #t))
(test-error (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling fixed_2 for define-created closure")
(test-begin "function calling variadic_2 for define-created closure")
(define (f x y . rest) (list x y rest))
(test-error (f))
(test-error (f . #t))
(test-error (f #t))
(test-error (f #t . #t))
(test-equal '(#t #t ())   (f #t #t))
(test-error (f #t #t . #t))
(test-equal '(#t #t (#t)) (f #t #t #t))
(test-error (f #t #t #t . #t))
(test-end "function calling variadic_2 for define-created closure")

;; Although SigScheme's eval facility itself does not ensure properness of
;; syntax args, each syntax implementation must check it. These tests only
;; indicate what should be done.
(test-begin "syntax application fixed_0")
;; FIXME: no syntax with syntax_fixed_0
(test-equal #t         ((lambda () #t)))
(test-error ((lambda () #t) . #t))
(test-error ((lambda () #t) #t))
(test-error ((lambda () #t) #t . #t))
(test-error ((lambda () #t) #t #t))
(test-error ((lambda () #t) #t #t . #t))
(test-error ((lambda () #t) #t #t #t))
(test-error ((lambda () #t) #t #t #t . #t))
(test-end "syntax application fixed_0")
(test-begin "syntax application variadic_0")
(test-equal #t          (and))
(test-error (and . #t))
(test-equal #t          (and #t))
(test-error (and #t . #t))
(test-equal #t          (and #t #t))
(test-error (and #t #t . #t))
(test-equal #t          (and #t #t #t))
(test-error (and #t #t #t . #t))
(test-end "syntax application variadic_0")
(test-begin "syntax application fixed_1")
(test-error (quote))
(test-error (quote . #t))
(test-equal #t         (quote #t))
(test-error (quote #t . #t))
(test-error (quote #t #t))
(test-error (quote #t #t . #t))
(test-error (quote #t #t #t))
(test-error (quote #t #t #t . #t))
(test-end "syntax application fixed_1")
(test-begin "syntax application variadic_1")
(test-error (let*))
(test-error (let* . #t))
(test-error (let* ()))
(test-error (let* #t . #t))
(test-equal #t            (let* () #t))
(test-error (let* #t #t . #t))
(test-equal #t            (let* () #t #t))
(test-error (let* #t #t #t . #t))
(test-end "syntax application variadic_1")
(test-begin "syntax application fixed_2")
(define foo #f)
(test-error (set!))
(test-error (set! . #t))
(test-error (set! #t))
(test-error (set! #t . #t))
(if (and (provided? "sigscheme")
         (provided? "strict-r5rs"))
    (test-equal (undef)   (set! foo #t))
    (test-equal #t        (set! foo #t)))
(test-error (set! #t #t . #t))
(test-error (set! #t #t #t))
(test-error (set! #t #t #t . #t))
(test-end "syntax application fixed_2")
(test-begin "syntax application variadic_2")
(test-error (if))
(test-error (if . #t))
(test-error (if #t))
(test-error (if #t . #t))
(test-equal #t            (if #t #t))
(test-error (if #t #t . #t))
(test-equal #t            (if #t #t #t))
(test-error (if #t #t #t . #t))
(test-end "syntax application variadic_2")

(test-begin "EOF immediately after quoter")
;; (quote #<eof>) is invalid
(test-error (string-read "'"))
(test-error (string-read "`"))
(test-error (string-read ","))
(test-error (string-read ",@"))
(test-end "EOF immediately after quoter")

(test-end "test-formal-syntax")
