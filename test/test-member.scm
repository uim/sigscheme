(require-extension (srfi 64))

(test-begin "test-member")

(define elm0 (lambda () 0))
(define elm1 (lambda () 1))
(define elm2 (lambda () 2))
(define elm3 (lambda () 3))
(define nil  '())
(define cdr3 (cons elm3 nil))
(define cdr2 (cons elm2 cdr3))
(define cdr1 (cons elm1 cdr2))
(define cdr0 (cons elm0 cdr1))
(define lst cdr0)

;; Remake char object to avoid constant optimization. If the implementation
;; does not have neither immediate char nor preallocated char objects, (eq? c
;; (char c)) will be false.
(define char
  (lambda (c)
    (integer->char (char->integer c))))

;;
;; memq
;;

(test-begin "memq")
(test-assert (not (memq 'a '())))
(test-assert (not (memq '() '())))
(test-equal '(()) (memq '() '(())))
(test-end "memq")
(test-begin "memq builtin procedures")
(test-equal (list + - * /) (memq + (list + - * /)))
(test-equal (list - * /)   (memq - (list + - * /)))
(test-equal (list * /)     (memq * (list + - * /)))
(test-equal (list /)       (memq / (list + - * /)))
(test-assert (not (memq car (list + - * /))))
(test-end "memq builtin procedures")
(test-begin "memq closures")
(test-equal cdr0 (memq elm0 lst))
(test-equal cdr1 (memq elm1 lst))
(test-equal cdr2 (memq elm2 lst))
(test-equal cdr3 (memq elm3 lst))
(test-assert (not (memq 'none lst)))
(test-end "memq closures")
(test-begin "memq strings with non-constant key")
;; These tests assume that (string-copy "a") is not optimized as constant
;; string.
(test-assert (not (memq (string-copy "a") '("a" "b" "c" "d"))))
(test-assert (not (memq (string-copy "b") '("a" "b" "c" "d"))))
(test-assert (not (memq (string-copy "c") '("a" "b" "c" "d"))))
(test-assert (not (memq (string-copy "d") '("a" "b" "c" "d"))))
(test-assert (not (memq (string-copy "e") '("a" "b" "c" "d"))))
(test-end "memq strings with non-constant key")
(test-begin "memq lists with non-constant key")
;; These tests assume that the keys are not optimized as constant object.
(test-assert (not (memq (list (string-copy "a")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memq (list (string-copy "b")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memq (list (string-copy "c")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memq (list (string-copy "d")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memq (list (string-copy "e")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memq (list (string-copy "aBc")
                              (list (string-copy "d") (list (string-copy "e"))))
                        '(("aBc" ("d" ("E"))) ("aBc" ("d" ("e"))) "f" ("g")))))
(test-end "memq lists with non-constant key")

(test-begin "memq improper lists: symbols")
(test-equal '(a b c . d) (memq 'a '(a b c . d)))
(test-equal '(b c . d)   (memq 'b '(a b c . d)))
(test-equal '(c . d)     (memq 'c '(a b c . d)))
(test-argcheck-error (memq 'd '(a b c . d)))
(test-argcheck-error (memq 'e '(a b c . d)))
(test-argcheck-error (memq 'a 'a))
(test-argcheck-error (memq 'b 'a))
(test-end "memq improper lists: symbols")
(test-begin "memq improper lists: strings with non-constant key")
(test-argcheck-error (memq (string-copy "a") '("a" "b" "c" . "d")))
(test-argcheck-error (memq (string-copy "b") '("a" "b" "c" . "d")))
(test-argcheck-error (memq (string-copy "c") '("a" "b" "c" . "d")))
(test-argcheck-error (memq (string-copy "d") '("a" "b" "c" . "d")))
(test-argcheck-error (memq (string-copy "e") '("a" "b" "c" . "d")))
(test-end "memq improper lists: strings with non-constant key")
(test-begin "memq improper lists: lists with non-constant key")
(test-argcheck-error (memq (list (string-copy "a"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memq (list (string-copy "b"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memq (list (string-copy "c"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memq (list (string-copy "d"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memq (list (string-copy "e"))
                           '(("a") ("b") ("c") . "d")))
(test-end "memq improper lists: lists with non-constant key")

(test-begin "memq from R5RS examples")
(test-equal '(a b c) (memq 'a '(a b c)))
(test-equal '(b c)   (memq 'b '(a b c)))
(test-assert (not (memq 'a '(b c d))))
(test-assert (not (memq (list 'a) '(b (a) c))))
(test-end "memq from R5RS examples")

;;
;; memv
;;

(test-begin "memv")
(test-assert (not (memv 'a '())))
(test-assert (not (memv '() '())))
(test-equal '(()) (memv '() '(())))
(test-end "memv")
(test-begin "memv symbols")
(test-equal '(a b c) (memv 'a '(a b c)))
(test-equal '(b c)   (memv 'b '(a b c)))
(test-assert (not (memv 'a '(b c d))))
(test-end "memv symbols")
(test-begin "memv builtin procedures")
(test-equal (list + - * /) (memv + (list + - * /)))
(test-equal (list - * /)   (memv - (list + - * /)))
(test-equal (list * /)     (memv * (list + - * /)))
(test-equal (list /)       (memv / (list + - * /)))
(test-assert (not (memv car (list + - * /))))
(test-end "memv builtin procedures")
(test-begin "memv closures")
(test-equal cdr0 (memv elm0 lst))
(test-equal cdr1 (memv elm1 lst))
(test-equal cdr2 (memv elm2 lst))
(test-equal cdr3 (memv elm3 lst))
(test-assert (not (memv 'none lst)))
(test-end "memv closures")
(test-begin "memv numbers")
(test-equal '(0 1 2 3) (memv 0 '(0 1 2 3)))
(test-equal '(1 2 3)   (memv 1 '(0 1 2 3)))
(test-equal '(2 3)     (memv 2 '(0 1 2 3)))
(test-equal '(3)       (memv 3 '(0 1 2 3)))
(test-assert (not (memv 4 '(0 1 2 3))))
(test-end "memv numbers")
(test-begin "memv chars")
(test-equal '(#\a #\b #\c #\d) (memv #\a '(#\a #\b #\c #\d)))
(test-equal '(#\b #\c #\d)     (memv #\b '(#\a #\b #\c #\d)))
(test-equal '(#\c #\d)         (memv #\c '(#\a #\b #\c #\d)))
(test-equal '(#\d)             (memv #\d '(#\a #\b #\c #\d)))
(test-assert (not (memv #\e '(#\a #\b #\c #\d))))
(test-end "memv chars")
(test-begin "memv strings with non-constant key")
;; These tests assume that (string-copy "a") is not optimized as constant
;; string.
(test-assert (not (memv (string-copy "a") '("a" "b" "c" "d"))))
(test-assert (not (memv (string-copy "b") '("a" "b" "c" "d"))))
(test-assert (not (memv (string-copy "c") '("a" "b" "c" "d"))))
(test-assert (not (memv (string-copy "d") '("a" "b" "c" "d"))))
(test-assert (not (memv (string-copy "e") '("a" "b" "c" "d"))))
(test-end "memv strings with non-constant key")
(test-begin "memv lists")
(test-assert (not (memv (list 'a) '(b (a) c))))
(test-end "memv lists")
(test-begin "memv lists with non-constant key")
;; These tests assume that the keys are not optimized as constant object.
(test-assert (not (memv (list (string-copy "a")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memv (list (string-copy "b")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memv (list (string-copy "c")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memv (list (string-copy "d")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memv (list (string-copy "e")) '(("a") ("b") ("c") ("d")))))
(test-assert (not (memv (list (string-copy "aBc")
                              (list (string-copy "d") (list (string-copy "e"))))
                        '(("aBc" ("d" ("E"))) ("aBc" ("d" ("e"))) "f" ("g")))))
(test-end "memv lists with non-constant key")

(test-begin "memv improper lists: symbols")
(test-equal '(a b c . d) (memv 'a '(a b c . d)))
(test-equal '(b c . d)   (memv 'b '(a b c . d)))
(test-equal '(c . d)     (memv 'c '(a b c . d)))
(test-argcheck-error (memv 'd '(a b c . d)))
(test-argcheck-error (memv 'e '(a b c . d)))
(test-argcheck-error (memv 'a 'a))
(test-argcheck-error (memv 'b 'a))
(test-end "memv improper lists: symbols")
(test-begin "memv improper lists: chars")
(test-equal '(#\a #\b #\c . #\d) (memv #\a '(#\a #\b #\c . #\d)))
(test-equal '(#\b #\c . #\d)     (memv #\b '(#\a #\b #\c . #\d)))
(test-equal '(#\c . #\d)         (memv #\c '(#\a #\b #\c . #\d)))
(test-argcheck-error (memv #\d '(#\a #\b #\c . #\d)))
(test-argcheck-error (memv #\e '(#\a #\b #\c . #\d)))
(test-end "memv improper lists: chars")
(test-begin "memv improper lists: strings with non-constant key")
(test-argcheck-error (memv (string-copy "a") '("a" "b" "c" . "d")))
(test-argcheck-error (memv (string-copy "b") '("a" "b" "c" . "d")))
(test-argcheck-error (memv (string-copy "c") '("a" "b" "c" . "d")))
(test-argcheck-error (memv (string-copy "d") '("a" "b" "c" . "d")))
(test-argcheck-error (memv (string-copy "e") '("a" "b" "c" . "d")))
(test-end "memv improper lists: strings with non-constant key")
(test-begin "memv improper lists: lists with non-constant key")
(test-argcheck-error (memv (list (string-copy "a"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memv (list (string-copy "b"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memv (list (string-copy "c"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memv (list (string-copy "d"))
                           '(("a") ("b") ("c") . "d")))
(test-argcheck-error (memv (list (string-copy "e"))
                           '(("a") ("b") ("c") . "d")))
(test-end "memv improper lists: lists with non-constant key")

;;
;; member
;;

(test-begin "member")
(test-assert (not (member 'a '())))
(test-assert (not (member '() '())))
(test-equal '(()) (member '() '(())))
(test-end "member")
(test-begin "member symbols")
(test-equal '(a b c) (member 'a '(a b c)))
(test-equal '(b c)   (member 'b '(a b c)))
(test-assert (not (member 'a '(b c d))))
(test-equal '((a) c) (member (list 'a) '(b (a) c)))  ;; R5RS
(test-end "member symbols")
(test-begin "member builtin procedures")
(test-equal (list + - * /) (member + (list + - * /)))
(test-equal (list - * /)   (member - (list + - * /)))
(test-equal (list * /)     (member * (list + - * /)))
(test-equal (list /)       (member / (list + - * /)))
(test-assert (not (member car (list + - * /))))
(test-end "member builtin procedures")
(test-begin "member closures")
(test-equal cdr0 (member elm0 lst))
(test-equal cdr1 (member elm1 lst))
(test-equal cdr2 (member elm2 lst))
(test-equal cdr3 (member elm3 lst))
(test-assert (not (member 'none lst)))
(test-end "member closures")
(test-begin "member numbers")
(test-equal '(0 1 2 3) (member 0 '(0 1 2 3)))
(test-equal '(1 2 3)   (member 1 '(0 1 2 3)))
(test-equal '(2 3)     (member 2 '(0 1 2 3)))
(test-equal '(3)       (member 3 '(0 1 2 3)))
(test-assert (not (member 4 '(0 1 2 3))))
(test-end "member numbers")
(test-begin "member chars")
(test-equal '(#\a #\b #\c #\d) (member #\a '(#\a #\b #\c #\d)))
(test-equal '(#\b #\c #\d)     (member #\b '(#\a #\b #\c #\d)))
(test-equal '(#\c #\d)         (member #\c '(#\a #\b #\c #\d)))
(test-equal '(#\d)             (member #\d '(#\a #\b #\c #\d)))
(test-assert (not (member #\e '(#\a #\b #\c #\d))))
(test-end "member chars")
(test-begin "member chars with non-constant key")
(test-equal '(#\a #\b #\c #\d) (member (char #\a) '(#\a #\b #\c #\d)))
(test-equal '(#\b #\c #\d)     (member (char #\b) '(#\a #\b #\c #\d)))
(test-equal '(#\c #\d)         (member (char #\c) '(#\a #\b #\c #\d)))
(test-equal '(#\d)             (member (char #\d) '(#\a #\b #\c #\d)))
(test-assert (not (member (char #\e) '(#\a #\b #\c #\d))))
(test-end "member chars with non-constant key")
(test-begin "member strings")
(test-equal '("a" "b" "c" "d") (member "a" '("a" "b" "c" "d")))
(test-equal '("b" "c" "d")     (member "b" '("a" "b" "c" "d")))
(test-equal '("c" "d")         (member "c" '("a" "b" "c" "d")))
(test-equal '("d")             (member "d" '("a" "b" "c" "d")))
(test-assert (not (member "e" '("a" "b" "c" "d"))))
(test-end "member strings")
(test-begin "member strings with non-constant key")
;; These tests assume that (string-copy "a") is not optimized as constant
;; string.
(test-equal '("a" "b" "c" "d") (member (string-copy "a") '("a" "b" "c" "d")))
(test-equal '("b" "c" "d")    (member (string-copy "b") '("a" "b" "c" "d")))
(test-equal '("c" "d")        (member (string-copy "c") '("a" "b" "c" "d")))
(test-equal '("d")            (member (string-copy "d") '("a" "b" "c" "d")))
(test-assert (not (member (string-copy "e") '("a" "b" "c" "d"))))
(test-end "member strings with non-constant key")
(test-begin "member lists")
(test-equal '(("a") ("b") ("c") ("d"))
            (member '("a") '(("a") ("b") ("c") ("d"))))
(test-equal '(("b") ("c") ("d"))
            (member '("b") '(("a") ("b") ("c") ("d"))))
(test-equal '(("c") ("d"))
            (member '("c") '(("a") ("b") ("c") ("d"))))
(test-equal '(("d"))
            (member '("d") '(("a") ("b") ("c") ("d"))))
(test-assert (not (member '("e") '(("a") ("b") ("c") ("d")))))
(test-equal '(("aBc" ("d" ("e"))) "f" ("g"))
            (member '("aBc" ("d" ("e")))
                    '(("aBc" ("d" ("E"))) ("aBc" ("d" ("e"))) "f" ("g"))))
(test-end "member lists")
(test-begin "member lists with non-constant key")
;; These tests assume that the keys are not optimized as constant object.
(test-equal '(("a") ("b") ("c") ("d"))
            (member (list (string-copy "a")) '(("a") ("b") ("c") ("d"))))
(test-equal '(("b") ("c") ("d"))
            (member (list (string-copy "b")) '(("a") ("b") ("c") ("d"))))
(test-equal '(("c") ("d"))
            (member (list (string-copy "c")) '(("a") ("b") ("c") ("d"))))
(test-equal '(("d"))
            (member (list (string-copy "d")) '(("a") ("b") ("c") ("d"))))
(test-assert (not (member (list (string-copy "e")) '(("a") ("b") ("c") ("d")))))
(test-equal '(("aBc" ("d" ("e"))) "f" ("g"))
            (member (list (string-copy "aBc")
                          (list (string-copy "d") (list (string-copy "e"))))
                    '(("aBc" ("d" ("E"))) ("aBc" ("d" ("e"))) "f" ("g"))))
(test-end "member lists with non-constant key")

(test-begin "member improper lists: symbols")
(test-equal '(a b c . d) (member 'a '(a b c . d)))
(test-equal '(b c . d)   (member 'b '(a b c . d)))
(test-equal '(c . d)     (member 'c '(a b c . d)))
(test-argcheck-error (member 'd '(a b c . d)))
(test-argcheck-error (member 'e '(a b c . d)))
(test-argcheck-error (member 'a 'a))
(test-argcheck-error (member 'b 'a))
(test-end "member improper lists: symbols")
(test-begin "member improper lists: chars")
(test-equal '(#\a #\b #\c . #\d) (member #\a '(#\a #\b #\c . #\d)))
(test-equal '(#\b #\c . #\d)     (member #\b '(#\a #\b #\c . #\d)))
(test-equal '(#\c . #\d)         (member #\c '(#\a #\b #\c . #\d)))
(test-argcheck-error (member #\d '(#\a #\b #\c . #\d)))
(test-argcheck-error (member #\e '(#\a #\b #\c . #\d)))
(test-end "member improper lists: chars")
(test-begin "member improper lists: chars with non-constant key")
(test-equal '(#\a #\b #\c . #\d) (member (char #\a)
                                         '(#\a #\b #\c . #\d)))
(test-equal '(#\b #\c . #\d)     (member (char #\b)
                                         '(#\a #\b #\c . #\d)))
(test-equal '(#\c . #\d)         (member (char #\c)
                                         '(#\a #\b #\c . #\d)))
(test-argcheck-error (member (char #\d)
                             '(#\a #\b #\c . #\d)))
(test-argcheck-error (member (char #\e)
                             '(#\a #\b #\c . #\d)))
(test-end "member improper lists: chars with non-constant key")
(test-begin "member improper lists: strings")
(test-equal '("a" "b" "c" . "d") (member "a" '("a" "b" "c" . "d")))
(test-equal '("b" "c" . "d")     (member "b" '("a" "b" "c" . "d")))
(test-equal '("c" . "d")         (member "c" '("a" "b" "c" . "d")))
(test-argcheck-error (member "d" '("a" "b" "c" . "d")))
(test-argcheck-error (member "e" '("a" "b" "c" . "d")))
(test-end "member improper lists: strings")
(test-begin "member improper lists: strings with non-constant key")
(test-equal '("a" "b" "c" . "d") (member (string-copy "a")
                                         '("a" "b" "c" . "d")))
(test-equal '("b" "c" . "d")     (member (string-copy "b")
                                         '("a" "b" "c" . "d")))
(test-equal '("c" . "d")         (member (string-copy "c")
                                         '("a" "b" "c" . "d")))
(test-argcheck-error (member (string-copy "d")
                             '("a" "b" "c" . "d")))
(test-argcheck-error (member (string-copy "e")
                             '("a" "b" "c" . "d")))
(test-end "member improper lists: strings with non-constant key")
(test-begin "member improper lists: lists with non-constant key")
(test-equal '(("a") ("b") ("c") . "d")
            (member (list (string-copy "a")) '(("a") ("b") ("c") . "d")))
(test-equal '(("b") ("c") . "d")
            (member (list (string-copy "b")) '(("a") ("b") ("c") . "d")))
(test-equal '(("c") . "d")
            (member (list (string-copy "c")) '(("a") ("b") ("c") . "d")))
(test-argcheck-error (member (list (string-copy "d"))
                             '(("a") ("b") ("c") . "d")))
(test-argcheck-error (member (list (string-copy "e"))
                             '(("a") ("b") ("c") . "d")))
(test-end "member improper lists: lists with non-constant key")


(test-end "test-member")
