          (min (least-fixnum)))
      (test-equal (quotient min -2) (expt 2 (- bits 1)))
      (test-equal min        (expt -2 bits))
      (test-error (expt 2 bits))
      (test-error (expt -2 (+ bits 1)))
      (test-error (expt 3 bits))))
(test-end "expt boundary numbers")

(test-begin "gcd and lcm boundary numbers")
(test-equal 0 (lcm 0 0))
(test-equal 0 (lcm 0 5))
(if (symbol-bound? 'greatest-fixnum)
    (let ((max (greatest-fixnum))
          (min (least-fixnum)))
      (test-equal max        (gcd max 0))
      (test-equal 2          (gcd min 2))
      (test-error (gcd min 0))
      (test-equal max        (lcm max 1))
      (test-error (lcm min 1))
      (test-error (lcm max 2))))
(test-end "gcd and lcm boundary numbers")

(test-begin "exactness")
(test-equal 1 (inexact->exact 1))
;; See test-real.scm when inexact numbers are supported.
(if (not (inexact? (/ 1 2)))
    (test-error (exact->inexact 1)))
(test-end "exactness")

(test-end "test-number-arith")
