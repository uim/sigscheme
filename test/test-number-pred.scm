(test-eq #f (number? 'symbol))
(test-eq #f (number? 'SYMBOL))
(test-eq #f (number? #\a))
(test-eq #f (number? #\あ))
(test-eq #f (number? ""))
(test-eq #f (number? " "))
(test-eq #f (number? "a"))
(test-eq #f (number? "A"))
(test-eq #f (number? "aBc12!"))
(test-eq #f (number? "あ"))
(test-eq #f (number? "あ0イう12!"))
(test-eq #f (number? +))
(test-eq #f (number? (lambda () #t)))

;; syntactic keywords should not be appeared as operand
(if sigscheme?
    (begin
      ;; pure syntactic keyword
      (test-error (number? else))
      ;; expression keyword
      (test-error (number? do))))

(call-with-current-continuation
 (lambda (k)
   (test-eq #f (number? k))))
(test-eq #f (number? (current-output-port)))
(test-eq #f (number? '(#t . #t)))
(test-eq #f (number? (cons #t #t)))
(test-eq #f (number? '(0 1 2)))
(test-eq #f (number? (list 0 1 2)))
(test-eq #f (number? '#()))
(test-eq #f (number? (vector)))
(test-eq #f (number? '#(0 1 2)))
(test-eq #f (number? (vector 0 1 2)))
(test-end "number?")

