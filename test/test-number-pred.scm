(test-error (odd? +))
(test-error (odd? (lambda () #t)))

;; syntactic keywords should not be appeared as operand
(if sigscheme?
    (begin
      ;; pure syntactic keyword
      (test-error (odd? else))
      ;; expression keyword
      (test-error (odd? do))))

(call-with-current-continuation
 (lambda (k)
   (test-error (odd? k))))
(test-error (odd? (current-output-port)))
(test-error (odd? '(#t . #t)))
(test-error (odd? (cons #t #t)))
(test-error (odd? '(0 1 2)))
(test-error (odd? (list 0 1 2)))
(test-error (odd? '#()))
(test-error (odd? (vector)))
(test-error (odd? '#(0 1 2)))
(test-error (odd? (vector 0 1 2)))
(test-end "odd?")

