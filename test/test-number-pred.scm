(require-extension (srfi 64))

(if (not (symbol-bound? 'number?))
    (test-skip-file "R5RS numbers is not enabled"))

(if (not (provided? "r6rs-chars"))
    (test-skip-file "R6RS characters is not enabled"))

(test-begin "test-number-pred")


(test-begin "number?")
(test-eq #f (number? #f))
(test-eq #f (number? #t))
(test-eq #f (number? '()))
(if (provided? "sigscheme")
    (begin
      (test-eq #f (number? (eof)))
      (test-eq #f (number? (undef)))))

;; binary
(test-eq #t (number? #b0))
(test-eq #t (number? #b-0))
(test-eq #t (number? #b+0))
(test-eq #t (number? #b1))
(test-eq #t (number? #b-1))
