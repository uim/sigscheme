(test-eq #t (number? #o-3))
(test-eq #t (number? #o+3))
;; decimal (implicit)
(test-eq #t (number? 0))
(test-eq #t (number? -0))
(test-eq #t (number? +0))
(test-eq #t (number? 1))
(test-eq #t (number? -1))
(test-eq #t (number? +1))
(test-eq #t (number? 3))
(test-eq #t (number? -3))
(test-eq #t (number? +3))
