(require-extension (srfi 64))

(if (not (provided? "r7rs"))
    (test-skip-file "R7RS is not enabled"))

(test-begin "test-r7rs")

(test-begin "vector literal")
(test-equal '#(1 2) #(1 2))
(test-equal '#() #())
(test-end "vector literal")

(test-begin "letrec*")
(test-equal 5
            (letrec* ((p (lambda (x) (+ 1 (q (- x 1)))))
                      (q (lambda (y) (if (zero? y) 0 (+ 1 (p (- y 1))))))
                      (x (p 5))
                      (y x))
              y))
(test-equal 3 (letrec* ((a 1) (b (+ a 1))) (+ a b)))
(test-equal 'ok (letrec* () 'ok))
(test-error (letrec* ((a)) a))
(test-error (letrec* (a) a))
(test-end "letrec*")

(test-begin "let-values")
(test-equal '(1 2 3 (4 5) (6 7))
            (let-values (((a b) (values 1 2))
                         ((c . d) (values 3 4 5))
                         (e (values 6 7)))
              (list a b c d e)))
(test-equal '(1 outer)
            (let ((a 'outer))
              (let-values (((a) (values 1))
                           ((b) (values a)))
                (list a b))))
(test-equal 1 (let-values (((a) 1)) a))
(test-equal 'ok (let-values () 'ok))
(test-error (let-values (((a b) (values 1))) a))
(test-error (let-values (((a) (values 1 2))) a))
(test-error (let-values (((a 1) (values 1 2))) a))
(test-error (let-values ((a)) a))
(test-end "let-values")

(test-begin "let*-values")
(test-equal '(1 1)
            (let ((a 'outer))
              (let*-values (((a) (values 1))
                            ((b) (values a)))
                (list a b))))
(test-equal '(1 2)
            (let*-values (((a b) (values 1 2))
                          ((a) (values (list a b))))
              a))
;; A closure in an earlier <init> doesn't see a later binding.
(test-equal 'outer
            (let ((a 'outer))
              (let*-values (((f) (values (lambda () a)))
                            ((a) (values 1)))
                (f))))
(test-equal 'ok (let*-values () 'ok))
(test-error (let*-values (((a b) (values 1))) a))
(test-end "let*-values")

(test-begin "case-lambda")
(define cl-plus
  (case-lambda
   (() 0)
   ((x) x)
   ((x y) (+ x y))
   (args (apply + args))))
(test-equal 0 (cl-plus))
(test-equal 1 (cl-plus 1))
(test-equal 3 (cl-plus 1 2))
(test-equal 6 (cl-plus 1 2 3))
(define cl-rest
  (case-lambda
   ((a) (list 'one a))
   ((a b . rest) (list 'many a b rest))))
(test-equal '(one 1) (cl-rest 1))
(test-equal '(many 1 2 ()) (cl-rest 1 2))
(test-equal '(many 1 2 (3)) (cl-rest 1 2 3))
(test-error (cl-rest))
(test-equal 11 (let ((x 10)) ((case-lambda ((a) (+ a x))) 1)))
(test-assert (procedure? (case-lambda)))
(test-error ((case-lambda)))
(test-error (case-lambda (1 2)))
(test-error (case-lambda x))
;; The call is in a tail context.
(define cl-loop
  (case-lambda
   ((n) (cl-loop n 'done))
   ((n result) (if (= n 0) result (cl-loop (- n 1) result)))))
(test-equal 'done (cl-loop 100000))
(test-end "case-lambda")

(test-begin "make-parameter")
(define param-a (make-parameter 1))
(test-equal 1 (param-a))
(define param-b (make-parameter 10 (lambda (x) (* x 2))))
(test-equal 20 (param-b))
(test-assert (procedure? param-a))
(test-error (param-a 2))
(test-error (make-parameter 1 2))
(test-end "make-parameter")

(test-begin "parameterize")
(test-equal '(2 6) (parameterize ((param-a 2) (param-b 3))
                     (list (param-a) (param-b))))
(test-equal '(1 20) (list (param-a) (param-b)))
(test-equal '(2 3 2)
            (parameterize ((param-a 2))
              (list (param-a)
                    (parameterize ((param-a 3)) (param-a))
                    (param-a))))
(test-equal 3 (parameterize ((param-a 2)) (define x 1) (+ x (param-a))))
(test-equal 'ok (parameterize () 'ok))
;; The value is restored when a continuation escapes from the body.
(test-equal 5
            (call-with-current-continuation
             (lambda (k)
               (parameterize ((param-a 5))
                 (k (param-a))))))
(test-equal 1 (param-a))
(test-error (parameterize ((car 1)) 1))
(test-error (parameterize ((param-a)) 1))
(test-error (parameterize (param-a) 1))
(test-end "parameterize")

(test-begin "syntax-rules ellipsis followed by patterns")
(test-equal '((0 1) 2)
            (let-syntax
                ((macro (syntax-rules ()
                          ((_ a ... b) '((a ...) b)))))
              (macro 0 1 2)))
(test-equal '((0) 1)
            (let-syntax
                ((macro (syntax-rules ()
                          ((_ (a ... . b)) '((a ...) b)))))
              (macro (0 . 1))))
(test-equal '((1 2 3) 4 5 6)
            (let-syntax
                ((macro (syntax-rules ()
                          ((_ (a ... b c . d)) '((a ...) b c d)))))
              (macro (1 2 3 4 5 . 6))))
(test-equal '((1 3) (2 4) 5)
            (let-syntax
                ((macro (syntax-rules ()
                          ((_ (m n) ... x) '((m ...) (n ...) x)))))
              (macro (1 2) (3 4) 5)))
(test-equal 'short
            (let-syntax
                ((macro (syntax-rules ()
                          ((_ a ... b c) 'long)
                          ((_ . r) 'short))))
              (macro 1)))
(test-error (syntax-rules ()
              ((_ a ... b ...) #f)))
(test-end "syntax-rules ellipsis followed by patterns")

(test-begin "syntax-rules custom ellipsis")
(test-equal '(1 2 3)
            (let-syntax
                ((macro (syntax-rules dots ()
                          ((_ x dots) '(x dots)))))
              (macro 1 2 3)))
(test-equal '(1 ...)
            (let-syntax
                ((macro (syntax-rules dots ()
                          ((_ x) '(x ...)))))
              (macro 1)))
(test-equal '(1 ...)
            (let-syntax
                ((macro (syntax-rules ... (...)
                          ((_ x) '(x ...)))))
              (macro 1)))
(test-end "syntax-rules custom ellipsis")

(test-begin "syntax-rules ellipsis escape")
(test-equal '...
            (let-syntax
                ((macro (syntax-rules ()
                          ((_) '(... ...)))))
              (macro)))
(test-equal '(1 ...)
            (let-syntax
                ((macro (syntax-rules ()
                          ((_ x) '(... (x ...))))))
              (macro 1)))
(define-syntax define-my-begin
  (syntax-rules ()
    ((_ name)
     (define-syntax name
       (syntax-rules ()
         ((_ expr (... ...))
          (begin expr (... ...))))))))
(define-my-begin my-begin)
(test-equal 3 (my-begin 1 2 3))
(test-end "syntax-rules ellipsis escape")

(test-begin "syntax-rules underscore")
(test-equal '_
            (let-syntax
                ((macro (syntax-rules ()
                          ((_ _) '_))))
              (macro 1)))
(test-equal '(2 0 many)
            (let-syntax
                ((macro (syntax-rules ()
                          ((_) 0)
                          ((_ _ _) 2)
                          ((_ . _) 'many))))
              (list (macro a b) (macro) (macro a b c))))
(test-equal '(2 fail)
            (let-syntax
                ((macro (syntax-rules (_)
                          ((_ _ _) 2)
                          ((x . y) 'fail))))
              (list (macro _ _) (macro a b))))
(test-end "syntax-rules underscore")

(test-begin "internal define-syntax")
(test-equal 1
            (let ()
              (define-syntax one
                (syntax-rules ()
                  ((_) 1)))
              (one)))
;; It isn't defined globally.
(test-assert (not (symbol-bound? 'one)))
;; A macro defined in the body refers to the definitions in the body.
(test-equal 42
            (let ()
              (define-syntax call-bar
                (syntax-rules ()
                  ((_) (bar))))
              (define (quux)
                (call-bar))
              (define (bar)
                42)
              (quux)))
;; A macro defined in the body can define other definitions.
(test-equal 'x
            (let ()
              (define-syntax define-quoter
                (syntax-rules ()
                  ((_ name y)
                   (define-syntax name
                     (syntax-rules ()
                       ((_ x) 'y))))))
              (define-quoter quoter x)
              (quoter 1)))
(test-equal '(1 2)
            (let ()
              (define-syntax define-two
                (syntax-rules ()
                  ((_ a b) (begin (define a 1) (define b 2)))))
              (define-two x y)
              (list x y)))
(test-error (let ()
              'expression
              (define-syntax one
                (syntax-rules ()
                  ((_) 1)))
              (one)))
(test-end "internal define-syntax")

(test-begin "promise?")
(test-eq #t (promise? (delay 1)))
(test-eq #t (promise? (delay-force (delay 1))))
(test-eq #t (promise? (make-promise 1)))
(test-eq #f (promise? '(1 . 2)))
(test-eq #f (promise? 1))
(test-end "promise?")

(test-begin "make-promise")
(test-equal 4 (force (make-promise (+ 2 2))))
(let ((promise (delay 1)))
  (test-eq promise (make-promise promise)))
(test-end "make-promise")

(test-begin "delay-force")
(test-equal 1 (force (delay-force (delay 1))))
;; delay doesn't force the result but delay-force does.
(test-eq #t (promise? (force (delay (delay 1)))))
(define (promise-chain n)
  (delay-force (if (= n 0) (make-promise 'done) (promise-chain (- n 1)))))
;; A long chain runs in constant space.
(test-eq 'done (force (promise-chain 100000)))
(test-error (force (delay-force 1)))
(test-end "delay-force")

(test-begin "force reentrancy")
;; R7RS 4.2.5: A promise may refer to its own value.
(define promise-count 0)
(define promise-x 5)
(define reentrant-promise
  (delay (begin
           (set! promise-count (+ promise-count 1))
           (if (> promise-count promise-x)
               promise-count
               (force reentrant-promise)))))
(test-equal 6 (force reentrant-promise))
(set! promise-x 10)
(test-equal 6 (force reentrant-promise))
(test-end "force reentrancy")

(test-begin "define-values")
(define-values (dv-a dv-b . dv-c) (values 1 2 3 4))
(test-equal '(1 2 (3 4)) (list dv-a dv-b dv-c))
(define-values dv-d (values 1 2))
(test-equal '(1 2) dv-d)
(define-values (dv-e) 5)
(test-equal 5 dv-e)
(test-equal '(1 2 3 (4 5))
            (let ()
              (define-values (a b) (values 1 2))
              (define c 3)
              (define-values r (values 4 5))
              (list a b c r)))
(test-equal 'g
            (let ()
              (define (f) (g))
              (define-values (g) (values (lambda () 'g)))
              (f)))
(test-equal 'ok
            (let ()
              (define-values () (values))
              'ok))
(test-error (let ()
              (define-values (a b) (values 1 2 3))
              a))
(test-error (let () (define-values (a b) (values 1)) #t))
(test-error (let ()
              (define-values (a 1) (values 1 2))
              a))
(test-end "define-values")

(test-begin "case =>")
(test-equal 'c
            (case (car '(c d))
              ((a b) 'ab)
              (else => (lambda (x) x))))
(test-equal '(vowel . a)
            (case 'a
              ((a e i o u) => (lambda (w) (cons 'vowel w)))
              (else 'x)))
(test-error (case 'a ((a) => 1)))
;; The call is in a tail context.
(define (case-loop n)
  (case n
    ((0) 'done)
    (else => (lambda (n) (case-loop (- n 1))))))
(test-equal 'done (case-loop 100000))
(test-end "case =>")

(test-begin "number predicates")
(test-eq #t (exact-integer? 1))
(test-eq #f (exact-integer? '()))
(test-eq #t (finite? 1))
(test-eq #f (infinite? 1))
(test-eq #f (nan? 1))
(test-error (finite? 'a))
(test-end "number predicates")

(test-begin "floor/ and truncate/")
(test-equal '(2 1) (call-with-values (lambda () (floor/ 5 2)) list))
(test-equal '(-3 1) (call-with-values (lambda () (floor/ -5 2)) list))
(test-equal '(-3 -1) (call-with-values (lambda () (floor/ 5 -2)) list))
(test-equal '(2 -1) (call-with-values (lambda () (floor/ -5 -2)) list))
(test-equal '(2 0) (call-with-values (lambda () (floor/ 4 2)) list))
(test-equal -3 (floor-quotient -5 2))
(test-equal 1 (floor-remainder -5 2))
(test-equal '(2 1) (call-with-values (lambda () (truncate/ 5 2)) list))
(test-equal '(-2 -1)
            (call-with-values (lambda () (truncate/ -5 2)) list))
(test-equal '(-2 1)
            (call-with-values (lambda () (truncate/ 5 -2)) list))
(test-equal '(2 -1)
            (call-with-values (lambda () (truncate/ -5 -2)) list))
(test-equal -2 (truncate-quotient -5 2))
(test-equal -1 (truncate-remainder -5 2))
(test-error (floor/ 1 0))
(test-error (floor-quotient 1 0))
(test-error (floor-remainder 1 0))
(test-error (truncate/ 1 0))
(test-error (truncate-quotient 1 0))
(test-error (truncate-remainder 1 0))
(if (symbol-bound? 'least-fixnum)
    (let ((min (least-fixnum)))
      (test-error (floor/ min -1))
      (test-error (floor-quotient min -1))
      (test-equal 0 (floor-remainder min -1))
      (test-error (truncate/ min -1))
      (test-error (truncate-quotient min -1))
      (test-equal 0 (truncate-remainder min -1))))
(test-end "floor/ and truncate/")

(test-begin "square")
(test-equal 0 (square 0))
(test-equal 1764 (square 42))
(test-equal 4 (square -2))
(if (symbol-bound? 'greatest-fixnum)
    (test-error (square (greatest-fixnum))))
(test-end "square")

(test-begin "exact-integer-sqrt")
(for-each (lambda (k expected)
            (test-equal expected
                        (call-with-values
                            (lambda () (exact-integer-sqrt k))
                          list)))
          '(0 1 2 3 4 5 8 9 10 17 32 99 100)
          '((0 0) (1 0) (1 1) (1 2) (2 0) (2 1) (2 4) (3 0) (3 1) (4 1)
            (5 7) (9 18) (10 0)))
(test-error (exact-integer-sqrt -1))
(test-end "exact-integer-sqrt")

(test-begin "exactness")
(test-equal 1 (exact 1))
;; See test-real.scm when inexact numbers are supported.
(if (not (inexact? (/ 1 2)))
    (test-error (inexact 1)))
(test-end "exactness")

(test-begin "boolean=?")
(test-eq #t (boolean=? #t #t))
(test-eq #t (boolean=? #f #f))
(test-eq #f (boolean=? #t #f))
(test-eq #t (boolean=? #f #f #f))
(test-eq #f (boolean=? #f #f #t))
(test-error (boolean=? #t))
(test-error (boolean=? #t 1))
(test-error (boolean=? #t #t 1))
(test-end "boolean=?")

(test-begin "make-list")
(test-equal '() (make-list 0))
(test-equal 2 (length (make-list 2)))
(test-equal '(x x x) (make-list 3 'x))
(test-error (make-list -1))
(test-error (make-list 'a))
(test-error (make-list 1 'x 'y))
(test-end "make-list")

(test-begin "list-set!")
(let ((lst (list 'a 'b 'c)))
  (list-set! lst 1 'x)
  (test-equal '(a x c) lst))
(test-error (list-set! (list 'a) 1 'x))
(test-error (list-set! (list 'a) -1 'x))
(test-end "list-set!")

(test-begin "list-copy")
(test-equal '() (list-copy '()))
(test-equal '(a b c) (list-copy '(a b c)))
(test-equal '(a b . c) (list-copy '(a b . c)))
(test-equal 'a (list-copy 'a))
(let* ((lst (list 'a 'b))
       (copy (list-copy lst)))
  (set-car! copy 'x)
  (test-equal '(a b) lst))
(test-end "list-copy")

(test-begin "member with compare")
(test-equal '("b" "c") (member "B" '("a" "b" "c") string-ci=?))
(test-eq #f (member "d" '("a" "b" "c") string-ci=?))
(test-equal '(2 3) (member 1 '(0 2 3) <))
(test-equal '("b" "c") (member "b" '("a" "b" "c")))
(test-error (member 1 '(1) 'x))
(test-end "member with compare")

(test-begin "assoc with compare")
(test-equal '(2 b) (assoc 2 '((1 a) (2 b)) =))
(test-equal '("B" 2) (assoc "b" '(("a" 1) ("B" 2)) string-ci=?))
(test-eq #f (assoc "c" '(("a" 1) ("B" 2)) string-ci=?))
(test-equal '("b" 2) (assoc "b" '(("a" 1) ("b" 2))))
(test-error (assoc 1 '(1) =))
(test-end "assoc with compare")

(test-begin "map")
(test-equal '(2 3) (map (lambda (x) (+ x 1)) '(1 2)))
(test-equal '(5 7 9) (map + '(1 2 3) '(4 5 6 7)))
(test-equal '(5 7) (map + '(1 2 3) '(4 5)))
(let ((lst (list 1 2)))
  (set-cdr! (cdr lst) lst)
  (test-equal '(11 22 31) (map + lst '(10 20 30))))
(test-error (r5rs:map + '(1 2 3) '(4 5)))
(test-end "map")

(test-begin "for-each")
(let ((sums '()))
  (for-each (lambda (x y) (set! sums (cons (+ x y) sums)))
            '(1 2 3) '(4 5))
  (test-equal '(7 5) sums))
(test-error (r5rs:for-each + '(1 2 3) '(4 5)))
(test-end "for-each")

(test-begin "symbol=?")
(test-eq #t (symbol=? 'a 'a))
(test-eq #f (symbol=? 'a 'b))
(test-eq #t (symbol=? 'a 'a 'a))
(test-eq #f (symbol=? 'a 'a 'b))
(test-error (symbol=? 'a))
(test-error (symbol=? 'a "a"))
(test-error (symbol=? 'a 'a "a"))
(test-end "symbol=?")

(test-begin "digit-value")
(test-equal 0 (digit-value #\0))
(test-equal 9 (digit-value #\9))
(test-eq #f (digit-value #\a))
(test-eq #f (digit-value #\.))
(test-error (digit-value 0))
(test-end "digit-value")

(test-begin "char comparisons")
(test-eq #t (char=? #\a #\a #\a))
(test-eq #f (char=? #\a #\a #\b))
(test-eq #t (char<? #\a #\b #\c))
(test-eq #f (char<? #\a #\c #\b))
(test-eq #t (char>? #\c #\b #\a))
(test-eq #t (char<=? #\a #\a #\b))
(test-eq #f (char<=? #\a #\b #\a))
(test-eq #t (char>=? #\b #\b #\a))
(test-eq #t (char-ci=? #\a #\A #\a))
(test-eq #t (char-ci<? #\a #\B #\c))
(test-eq #t (char-ci>? #\C #\b #\A))
(test-eq #t (char-ci<=? #\a #\A #\b))
(test-eq #t (char-ci>=? #\b #\B #\a))
(test-eq #t (char=? #\a #\a))
(test-error (char=? #\a #\a 'a))
(test-error (char=? #\a))
(test-end "char comparisons")

(test-begin "char-foldcase")
(test-equal #\a (char-foldcase #\a))
(test-equal #\a (char-foldcase #\A))
(test-equal #\1 (char-foldcase #\1))
(test-error (char-foldcase "a"))
(test-end "char-foldcase")

(test-begin "string-upcase")
(test-equal "ABC1" (string-upcase "aBc1"))
(test-equal "" (string-upcase ""))
(test-error (string-upcase #\a))
(test-end "string-upcase")

(test-begin "string-downcase")
(test-equal "abc1" (string-downcase "aBc1"))
(test-equal "" (string-downcase ""))
(test-error (string-downcase #\a))
(test-end "string-downcase")

(test-begin "string-foldcase")
(test-equal "abc1" (string-foldcase "aBc1"))
(test-equal "" (string-foldcase ""))
(test-error (string-foldcase #\a))
(test-end "string-foldcase")

(test-begin "string comparisons")
(test-eq #t (string=? "a" "a" "a"))
(test-eq #f (string=? "a" "a" "b"))
(test-eq #t (string<? "a" "b" "c"))
(test-eq #f (string<? "a" "c" "b"))
(test-eq #t (string>? "c" "b" "a"))
(test-eq #t (string<=? "a" "a" "b"))
(test-eq #f (string<=? "a" "b" "a"))
(test-eq #t (string>=? "b" "b" "a"))
(test-eq #t (string-ci=? "a" "A" "a"))
(test-eq #t (string-ci<? "a" "B" "c"))
(test-eq #t (string-ci>? "C" "b" "A"))
(test-eq #t (string-ci<=? "a" "A" "b"))
(test-eq #t (string-ci>=? "b" "B" "a"))
(test-error (string=? "a" "a" 'a))
(test-end "string comparisons")

(test-begin "string->list")
(test-equal '(#\a #\b #\c) (string->list "abc"))
(test-equal '(#\b #\c) (string->list "abc" 1))
(test-equal '(#\b) (string->list "abc" 1 2))
(test-error (string->list "abc" 2 1))
(test-end "string->list")

(test-begin "string-copy")
(test-equal "abc" (string-copy "abc"))
(test-equal "bc" (string-copy "abc" 1))
(test-equal "b" (string-copy "abc" 1 2))
(test-equal "" (string-copy "abc" 3))
(test-error (string-copy "abc" 4))
(test-end "string-copy")

(test-begin "string-copy!")
(let ((str (string-copy "abcde")))
  (string-copy! str 1 "12")
  (test-equal "a12de" str))
(let ((str (string-copy "abcde")))
  (string-copy! str 0 "123" 1 3)
  (test-equal "23cde" str))
(let ((str (string-copy "abcde")))
