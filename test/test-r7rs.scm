(test-begin "features")
(test-assert (list? (features)))
(test-assert (and (memq 'r7rs (features)) #t))
(test-assert (not (memq '|*test-r7rs.scm-loaded*| (features))))
(test-assert (and (memq (string->symbol
                        (string-append "sigscheme-" (sscm-version)))
                       (features))
                 #t))
;; Inexact numbers are IEEE 754 doubles if they are supported.
(test-equal (and (string->number "0.5") #t)
            (and (memq 'ieee-float (features)) #t))
;; Features that aren't provided.
(test-assert (not (memq 'ratios (features))))
(test-assert (not (memq 'exact-complex (features))))
;; At most one data model.
(test-assert (<= (+ (if (memq 'ilp32 (features)) 1 0)
                    (if (memq 'lp64 (features)) 1 0)
                    (if (memq 'llp64 (features)) 1 0))
                 1))
(test-end "features")

(if (and (symbol-bound? '%%current-char-codec)
         (equal? (%%current-char-codec) "UTF-8"))
    (let ((alpha (string (integer->char #x3b1)))
          (capital-alpha (string (integer->char #x391))))
      (test-begin "string case conversion with non-ASCII characters")
      (if (provided? "full-unicode")
          (begin
            (test-equal (string-append "A" capital-alpha "B")
                        (string-upcase (string-append "a" alpha "b")))
            (test-equal (string-append "a" alpha "b")
                        (string-downcase
                         (string-append "A" capital-alpha "B"))))
          ;; Only ASCII characters are converted.
          (begin
            (test-equal (string-append "A" alpha "B")
                        (string-upcase (string-append "a" alpha "b")))
            (test-equal (string-append "a" capital-alpha "b")
                        (string-downcase
                         (string-append "A" capital-alpha "B")))))
      (test-equal 3
                  (string-length
                   (string-upcase (string-append "a" alpha "b"))))
      (test-end "string case conversion with non-ASCII characters")
      (test-begin "string mutation with non-ASCII characters")
      (let ((str (string-copy "abc")))
        (string-fill! str (integer->char #x3b1) 1 2)
        (test-equal (string-append "a" alpha "c") str))
      (let ((str (string-append "a" alpha "c")))
        (string-copy! str 1 "b")
        (test-equal "abc" str))
      (let ((str (string-copy "abcd")))
        (string-copy! str 1 (string-append alpha capital-alpha))
        (test-equal (string-append "a" alpha capital-alpha "d") str)
        (test-equal 4 (string-length str)))
      (test-end "string mutation with non-ASCII characters")))

(if (provided? "full-unicode")
    (let ((sharp-s (string (integer->char #xdf)))
          (capital-sigma (integer->char #x3a3))
          (sigma (integer->char #x3c3))
          (thai-three (integer->char #xe53)))
      (test-begin "Unicode characters")
      (test-assert (char-alphabetic? (integer->char #x3042)))
      (test-assert (char-upper-case? capital-sigma))
      (test-assert (char-lower-case? sigma))
      (test-assert (char-whitespace? (integer->char #x3000)))
      (test-assert (char-numeric? thai-three))
      (test-equal 3 (digit-value thai-three))
      (test-equal sigma (char-downcase capital-sigma))
      (test-equal capital-sigma (char-upcase sigma))
      (test-equal sigma (char-foldcase capital-sigma))
      (test-assert (char-ci=? sigma capital-sigma))
      ;; The simple case mapping is used for a character.
      (test-equal (integer->char #xdf)
                  (char-upcase (integer->char #xdf)))
      (test-end "Unicode characters")

      (test-begin "Unicode full case mappings")
      (test-equal "SS" (string-upcase sharp-s))
      (test-equal "mass" (string-foldcase (string-append "Ma" sharp-s)))
      ;; U+0130 LATIN CAPITAL LETTER I WITH DOT ABOVE
      (test-equal (string #\i (integer->char #x307))
                  (string-downcase (string (integer->char #x130))))
      (test-assert (string-ci=? (string-append "Stra" sharp-s "e")
                                "STRASSE"))
      (test-assert (string-ci<? sharp-s "st"))
      (test-assert (not (string-ci<? "st" sharp-s)))
      (test-end "Unicode full case mappings")

      (test-begin "Unicode with non-Unicode codec")
      ;; Non-ASCII characters of ISO-8859-1 aren't Unicode characters.
      (with-char-codec "ISO-8859-1"
        (lambda ()
          (test-assert (not (char-alphabetic? (integer->char #xff))))
          (test-equal (integer->char #xff)
                      (char-upcase (integer->char #xff)))))
      (test-end "Unicode with non-Unicode codec")))

