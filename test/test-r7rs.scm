(test-error (bytevector 1 'a))
(test-end "bytevector")

(test-begin "bytevector-u8-ref")
(test-equal 8 (bytevector-u8-ref #u8(1 1 2 3 5 8 13 21) 5))
(test-error (bytevector-u8-ref #u8(1 2) 2))
(test-error (bytevector-u8-ref #u8(1 2) -1))
(test-error (bytevector-u8-ref (vector 1 2) 0))
(test-end "bytevector-u8-ref")

(test-begin "bytevector-u8-set!")
(test-equal #u8(1 3 3 4)
            (let ((bv (bytevector 1 2 3 4)))
              (bytevector-u8-set! bv 1 3)
              bv))
(test-error (bytevector-u8-set! (bytevector 1) 1 0))
(test-error (bytevector-u8-set! (bytevector 1) 0 256))
(test-end "bytevector-u8-set!")

(test-begin "bytevector-copy")
(test-equal #u8(3 4) (bytevector-copy #u8(1 2 3 4 5) 2 4))
(test-equal #u8(3 4 5) (bytevector-copy #u8(1 2 3 4 5) 2))
(let* ((bv (bytevector 1 2 3))
       (copy (bytevector-copy bv)))
  (test-equal bv copy)
  (test-assert (not (eq? bv copy)))
  (bytevector-u8-set! copy 0 9)
  (test-equal 1 (bytevector-u8-ref bv 0)))
(test-error (bytevector-copy #u8(1 2) 3))
(test-error (bytevector-copy #u8(1 2) 1 0))
(test-end "bytevector-copy")

(test-begin "bytevector-copy!")
(test-equal #u8(1 3 4 4 5)
            (let ((a (bytevector 1 2 3 4 5))
                  (b (bytevector 10 20 30 40 50)))
              (bytevector-copy! b 1 a 0 2)
              (bytevector-copy! a 1 a 2 4)
              a))
(test-equal #u8(10 1 2 40 50)
            (let ((a (bytevector 1 2 3 4 5))
                  (b (bytevector 10 20 30 40 50)))
              (bytevector-copy! b 1 a 0 2)
              b))
(test-error (bytevector-copy! (bytevector 1 2) 1 #u8(1 2)))
(test-end "bytevector-copy!")

(test-begin "bytevector-append")
(test-equal #u8() (bytevector-append))
(test-equal #u8(0 1 2 3 4 5)
            (bytevector-append #u8(0 1 2) #u8() #u8(3 4 5)))
(test-error (bytevector-append #u8(1) (vector 2)))
(test-end "bytevector-append")

(test-begin "utf8->string")
(test-equal "A" (utf8->string #u8(#x41)))
(test-equal "\x3bb;" (utf8->string #u8(#xce #xbb)))
(test-equal "\x3bb;b" (utf8->string #u8(#x61 #xce #xbb #x62) 1))
(test-equal "\x3bb;" (utf8->string #u8(#x61 #xce #xbb #x62) 1 3))
(test-equal "" (utf8->string #u8()))
(test-error (utf8->string #u8(#xff)))
(test-error (utf8->string #u8(#xce)))
(test-error (utf8->string #u8(#x61 #xce #xbb) 0 2))
(test-end "utf8->string")

(test-begin "string->utf8")
(test-equal #u8(#xce #xbb) (string->utf8 "\x3bb;"))
(test-equal #u8(#xce #xbb #x62) (string->utf8 "a\x3bb;b" 1))
(test-equal #u8(#xce #xbb) (string->utf8 "a\x3bb;b" 1 2))
(test-equal #u8() (string->utf8 ""))
(test-error (string->utf8 "abc" 4))
(test-end "string->utf8")

(test-begin "bytevector equal?")
(test-assert (equal? #u8(1 2) (bytevector 1 2)))
(test-assert (not (equal? #u8(1 2) #u8(1 3))))
(test-assert (not (equal? #u8(1 2) #u8(1 2 3))))
(test-assert (not (equal? #u8(1 2) (vector 1 2))))
(test-end "bytevector equal?")

(test-begin "bytevector write")
(test-equal "#u8(0 128 255)"
            (let ((port (open-output-string)))
              (write #u8(0 128 255) port)
              (get-output-string port)))
(test-equal "#u8()"
            (let ((port (open-output-string)))
              (display (bytevector) port)
              (get-output-string port)))
(test-end "bytevector write")

(test-begin "binary-port?")
(test-assert (binary-port? (open-input-bytevector #u8())))
(test-assert (binary-port? (open-output-bytevector)))
(test-assert (not (textual-port? (open-input-bytevector #u8()))))
(test-assert (not (binary-port? (open-input-string ""))))
(test-assert (input-port? (open-input-bytevector #u8())))
(test-assert (output-port? (open-output-bytevector)))
(test-end "binary-port?")

(test-begin "read-u8")
(let ((port (open-input-bytevector #u8(1 0 255))))
  (test-equal 1 (peek-u8 port))
  (test-equal 1 (read-u8 port))
  (test-equal 0 (read-u8 port))
  (test-assert (u8-ready? port))
  (test-equal 255 (read-u8 port))
  (test-assert (eof-object? (peek-u8 port)))
  (test-assert (eof-object? (read-u8 port))))
(test-error (read-u8 (open-input-string "a")))
(let ((bv (bytevector 1 2)))
  (let ((port (open-input-bytevector bv)))
    (bytevector-u8-set! bv 0 9)
    (test-equal 1 (read-u8 port))))
(test-end "read-u8")

(test-begin "read-bytevector")
(let ((port (open-input-bytevector #u8(1 2 3 4 5))))
  (test-equal #u8(1 2) (read-bytevector 2 port))
  (test-equal #u8() (read-bytevector 0 port))
  (test-equal #u8(3 4 5) (read-bytevector 10 port))
  (test-assert (eof-object? (read-bytevector 1 port))))
(test-error (read-bytevector -1 (open-input-bytevector #u8())))
(test-end "read-bytevector")

(test-begin "read-bytevector!")
(let ((bv (make-bytevector 5 0))
      (port (open-input-bytevector #u8(1 2 3))))
  (test-equal 2 (read-bytevector! bv port 1 3))
  (test-equal #u8(0 1 2 0 0) bv)
  (test-equal 1 (read-bytevector! bv port))
  (test-equal #u8(3 1 2 0 0) bv)
  (test-assert (eof-object? (read-bytevector! bv port))))
(test-error (read-bytevector! (make-bytevector 1)
                              (open-input-bytevector #u8(1))
                              2))
(test-end "read-bytevector!")

(test-begin "write-u8")
(let ((port (open-output-bytevector)))
  (write-u8 0 port)
  (write-u8 255 port)
  (test-equal #u8(0 255) (get-output-bytevector port)))
(test-error (write-u8 256 (open-output-bytevector)))
(test-error (write-u8 1 (open-output-string)))
(test-end "write-u8")

(test-begin "write-bytevector")
(let ((port (open-output-bytevector)))
  (write-bytevector #u8(1 2 3 4) port)
  (write-bytevector #u8(5 6 7 8) port 1)
  (write-bytevector #u8(9 10 11 12) port 1 3)
  (test-equal #u8(1 2 3 4 6 7 8 10 11) (get-output-bytevector port)))
(test-error (write-bytevector #u8(1) (open-output-string)))
(test-end "write-bytevector")

(test-begin "get-output-bytevector")
(test-equal #u8() (get-output-bytevector (open-output-bytevector)))
(test-error (get-output-bytevector (open-output-string)))
(test-end "get-output-bytevector")

(test-begin "binary file ports")
(let ((path "test-r7rs-binary.tmp"))
  (let ((port (open-binary-output-file path)))
    (test-assert (binary-port? port))
    (write-bytevector #u8(0 1 2 200) port)
    (close-port port))
  (let ((port (open-binary-input-file path)))
    (test-assert (binary-port? port))
    (test-equal #u8(0 1 2 200) (read-bytevector 10 port))
    (close-port port))
  (delete-file path))
(test-assert (file-error? (guard (e (#t e))
                            (open-binary-input-file " no such file "))))
(test-end "binary file ports")

(test-begin "when")
(test-equal 2 (when #t 1 2))
(test-equal (undef) (when #f 1 2))
(test-equal 'a (when (= 1 1) 'a))
(test-equal (undef)
            (let loop ((n 100000))
              (when (> n 0) (loop (- n 1)))))
(test-end "when")

(test-begin "unless")
(test-equal 2 (unless #f 1 2))
(test-equal (undef) (unless #t 1 2))
(test-end "unless")

(test-begin "syntax-error")
(define-syntax r7rs-must-be-pair
  (syntax-rules ()
    ((_ (a . b)) 'ok)
    ((_ x) (syntax-error "pair required" x))))
(test-equal 'ok (r7rs-must-be-pair (1 . 2)))
(test-equal '("pair required" (3))
            (guard (e (#t (list (error-object-message e)
                                (error-object-irritants e))))
              (r7rs-must-be-pair 3)))
(test-end "syntax-error")

(test-begin "call-with-port")
(let ((port (open-input-string "ab")))
  (test-equal #\a (call-with-port port read-char))
  (test-assert (not (input-port-open? port))))
(test-equal '(1 2)
            (call-with-values
                (lambda ()
                  (call-with-port (open-input-string "")
                                  (lambda (port) (values 1 2))))
              list))
(test-end "call-with-port")

(test-begin "case-insensitive # notations")
(test-equal '(#t #f #t #f) (list #T #F #TRUE #False))
(test-equal '(26 3 15 9) (list #X1a #B11 #O17 #D9))
(test-equal #u8(1 2) #U8(1 2))
(test-end "case-insensitive # notations")

(define (r7rs-write-to-string write obj)
  (let ((port (open-output-string)))
    (write obj port)
    (get-output-string port)))

(test-begin "write cycles")
(let ((x (list 1 2 3)))
  (set-cdr! (cddr x) x)
  (test-equal "#1=(1 2 3 . #1#)" (r7rs-write-to-string write x))
  (test-equal "#1=(1 2 3 . #1#)" (r7rs-write-to-string display x)))
(let ((x (list 'a 'b)))
  (set-car! x x)
  (test-equal "#1=(#1# b)" (r7rs-write-to-string write x)))
(let ((v (vector 1 2)))
  (vector-set! v 1 v)
  (test-equal "#1=#(1 #1#)" (r7rs-write-to-string write v)))
(let* ((s (list 1 2))
       (x (list s s)))
  (set-cdr! (cdr s) x)
  ;; S is shared but it isn't labeled because it's not needed to break the
  ;; cycle.
  (test-equal "#1=((1 2 . #1#) (1 2 . #1#))"
              (r7rs-write-to-string write x)))
(test-end "write cycles")

(test-begin "write shared structure without cycles")
(let ((x (list 1 2)))
  (test-equal "((1 2) (1 2))" (r7rs-write-to-string write (list x x)))
  (test-equal "#((1 2) (1 2))"
              (r7rs-write-to-string write (vector x x)))
  (test-equal "((1 2) (1 2))"
              (r7rs-write-to-string write-simple (list x x)))
  (test-equal "(#1=(1 2) #1#)"
              (r7rs-write-to-string write-shared (list x x))))
(test-end "write shared structure without cycles")

;; Records are available without requiring SRFI-9.
(test-begin "define-record-type")
(define-record-type <r7rs-pare> (r7rs-kons x y) r7rs-pare?
  (x r7rs-kar r7rs-set-kar!)
  (y r7rs-kdr))
(test-assert (r7rs-pare? (r7rs-kons 1 2)))
(test-assert (not (r7rs-pare? (cons 1 2))))
(test-assert (not (r7rs-pare? (vector <r7rs-pare> 1 2))))
(test-equal 1 (r7rs-kar (r7rs-kons 1 2)))
(test-equal 2 (r7rs-kdr (r7rs-kons 1 2)))
(test-equal 3
            (let ((k (r7rs-kons 1 2)))
              (r7rs-set-kar! k 3)
              (r7rs-kar k)))
(test-error (r7rs-kar (cons 1 2)))
(test-assert (not (vector? (r7rs-kons 1 2))))
(test-assert (not (equal? (r7rs-kons 1 2) (r7rs-kons 1 2))))
(test-equal "#<record <r7rs-pare>>"
            (let ((port (open-output-string)))
              (write (r7rs-kons 1 2) port)
              (get-output-string port)))
(test-equal '(#t 5)
            (let ()
              (define-record-type point (make-point x y) point?
                (x point-x)
                (y point-y))
              (list (point? (make-point 5 6)) (point-x (make-point 5 6)))))
(test-assert (not (symbol-bound? 'point?)))
(test-end "define-record-type")

(test-end "test-r7rs")
