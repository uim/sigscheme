;; find
(test-begin "find invalid forms")
(test-argcheck-error (find even? '#(1 2)))
(test-error (find 1 '(1 2)))
(test-end "find invalid forms")
(test-begin "find proper list")
(test-assert (not (find even?                     '())))
(test-assert (not (find (lambda (x) #f)           lst)))
(test-eq elm0 (find (lambda (x) (eq? x elm0)) lst))
(test-eq elm1 (find (lambda (x) (eq? x elm1)) lst))
(test-eq elm2 (find (lambda (x) (eq? x elm2)) lst))
(test-eq elm8 (find (lambda (x) (eq? x elm8)) lst))
(test-eq elm9 (find (lambda (x) (eq? x elm9)) lst))
(test-end "find proper list")
(test-begin "find dotted list")
(test-argcheck-error (find even? 1))
(test-equal 1            (find (lambda (x) (= x 1)) '(1 . 2)))
(test-equal 2            (find (lambda (x) (= x 2)) '(1 2 . 3)))
(test-equal 3            (find (lambda (x) (= x 3)) '(1 2 3 . 4)))
(test-argcheck-error (find even? '(1 . 2)))
(test-equal 2            (find even? '(1 2 . 3)))
(test-equal 2            (find even? '(1 2 3 . 4)))
(test-equal 1            (find odd?  '(1 . 2)))
(test-equal 1            (find odd?  '(1 2 . 3)))
(test-equal 1            (find odd?  '(1 2 3 . 4)))
(test-end "find dotted list")
(test-begin "find circular list")
;; Rotates the circular list as like as find-tail.
(test-equal 1 (find (lambda (x) (= x 1)) clst4))
(test-equal 2 (find (lambda (x) (= x 2)) clst4))
(test-equal 3 (find (lambda (x) (= x 3)) clst4))
(test-equal 4 (find (lambda (x) (= x 4)) clst4))
(test-equal 1
            (let ((cnt 2))
              (find (lambda (x)
                           (if (= x 1)
                               (set! cnt (- cnt 1)))
                           (and (zero? cnt)
                                (= x 1)))
                         clst4)))
(test-equal 2
            (let ((cnt 2))
              (find (lambda (x)
                           (if (= x 1)
                               (set! cnt (- cnt 1)))
                           (and (zero? cnt)
                                (= x 2)))
                         clst4)))
(test-equal 3
            (let ((cnt 2))
              (find (lambda (x)
                           (if (= x 1)
                               (set! cnt (- cnt 1)))
                           (and (zero? cnt)
                                (= x 3)))
                         clst4)))
(test-equal 1
            (let ((cnt 3))
              (find (lambda (x)
                           (if (= x 1)
                               (set! cnt (- cnt 1)))
                           (and (zero? cnt)
                                (= x 1)))
                         clst4)))
(test-equal 1
            (let ((cnt 4))
              (find (lambda (x)
                           (if (= x 1)
                               (set! cnt (- cnt 1)))
                           (and (zero? cnt)
                                (= x 1)))
                         clst4)))
(test-end "find circular list")

;; find-tail
(test-begin "find-tail invalid forms")
(test-argcheck-error (find-tail even? '#(1 2)))
(test-error (find-tail 1 '(1 2)))
(test-end "find-tail invalid forms")
(test-begin "find-tail proper list")
;; Although the behavior on null list is not explicitly defined in SRFI-1
;; itself, the reference implementation returns #f So SigScheme followed it.
(test-assert (not (find-tail even?                     '())))
(test-assert (not (find-tail (lambda (x) #f)           lst)))
(test-eq lst  (find-tail (lambda (x) (eq? x elm0)) lst))
(test-eq cdr1 (find-tail (lambda (x) (eq? x elm1)) lst))
(test-eq cdr2 (find-tail (lambda (x) (eq? x elm2)) lst))
(test-eq cdr8 (find-tail (lambda (x) (eq? x elm8)) lst))
(test-eq cdr9 (find-tail (lambda (x) (eq? x elm9)) lst))
(test-end "find-tail proper list")
(test-begin "find-tail dotted list")
(test-argcheck-error (find-tail even? 1))
;; Although the behavior on dotted list is not defined in SRFI-1 itself, the
;; reference implementation returns the last pair. So SigScheme followed it.
(test-equal '(1 . 2)     (find-tail (lambda (x) (= x 1)) '(1 . 2)))
(test-equal '(2 . 3)     (find-tail (lambda (x) (= x 2)) '(1 2 . 3)))
(test-equal '(3 . 4)     (find-tail (lambda (x) (= x 3)) '(1 2 3 . 4)))
(test-argcheck-error (find-tail even? '(1 . 2)))
(test-equal '(2 . 3)     (find-tail even? '(1 2 . 3)))
(test-equal '(2 3 . 4)   (find-tail even? '(1 2 3 . 4)))
(test-equal '(1 . 2)     (find-tail odd?  '(1 . 2)))
(test-equal '(1 2 . 3)   (find-tail odd?  '(1 2 . 3)))
(test-equal '(1 2 3 . 4) (find-tail odd?  '(1 2 3 . 4)))
(test-end "find-tail dotted list")
(test-begin "find-tail circular list")
;; SRFI-1: In the circular-list case, this procedure "rotates" the list.
(test-eq clst4 (find-tail (lambda (x) (= x 1)) clst4))
(test-eq (my-list-tail clst4 1) (find-tail (lambda (x) (= x 2))
                                           clst4))
(test-eq (my-list-tail clst4 2) (find-tail (lambda (x) (= x 3))
                                           clst4))
(test-eq (my-list-tail clst4 3) (find-tail (lambda (x) (= x 4))
                                           clst4))
(test-eq clst4
         (let ((cnt 2))
           (find-tail (lambda (x)
                        (if (= x 1)
                            (set! cnt (- cnt 1)))
                        (and (zero? cnt)
                             (= x 1)))
                      clst4)))
(test-eq (my-list-tail clst4 1)
         (let ((cnt 2))
           (find-tail (lambda (x)
                        (if (= x 1)
                            (set! cnt (- cnt 1)))
                        (and (zero? cnt)
                             (= x 2)))
                      clst4)))
(test-eq (my-list-tail clst4 2)
         (let ((cnt 2))
           (find-tail (lambda (x)
                        (if (= x 1)
                            (set! cnt (- cnt 1)))
                        (and (zero? cnt)
                             (= x 3)))
                      clst4)))
(test-eq clst4
         (let ((cnt 3))
           (find-tail (lambda (x)
                        (if (= x 1)
                            (set! cnt (- cnt 1)))
                        (and (zero? cnt)
                             (= x 1)))
                      clst4)))
(test-eq clst4
         (let ((cnt 4))
           (find-tail (lambda (x)
                        (if (= x 1)
                            (set! cnt (- cnt 1)))
                        (and (zero? cnt)
                             (= x 1)))
                      clst4)))
(test-end "find-tail circular list")

