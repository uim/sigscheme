(require-extension (srfi 64))

(require-extension (srfi 1 6 23 38))

(if (not (provided? "r6rs-chars"))
    (test-skip-file "R6RS characters is not enabled"))

(test-begin "test-srfi1-another")

;;(define drop list-tail)

;; To prevent being affected from possible bug of the C implementation of
;; list-tail, tests in this file use this R5RS definition of list-tail.
(define my-list-tail
  (lambda (x k)
    (if (zero? k)
        x
        (my-list-tail (cdr x) (- k 1)))))

;; unique objects
(define elm0 (list 0))
(define elm1 (list 1))
(define elm2 (list 2))
(define elm3 (list 3))
(define elm4 (list 4))
(define elm5 (list 5))
(define elm6 (list 6))
(define elm7 (list 7))
(define elm8 (list 8))
(define elm9 (list 9))
;; sublists
(define cdr9 (cons elm9 '()))
(define cdr8 (cons elm8 cdr9))
(define cdr7 (cons elm7 cdr8))
(define cdr6 (cons elm6 cdr7))
(define cdr5 (cons elm5 cdr6))
(define cdr4 (cons elm4 cdr5))
(define cdr3 (cons elm3 cdr4))
(define cdr2 (cons elm2 cdr3))
(define cdr1 (cons elm1 cdr2))
(define cdr0 (cons elm0 cdr1))
(define lst cdr0)
;; circular lists
(define clst1 (list 1))
(set-cdr! clst1 clst1)
(define clst2 (list 1 2))
(set-cdr! (my-list-tail clst2 1) clst2)
(define clst3 (list 1 2 3))
(set-cdr! (my-list-tail clst3 2) clst3)
(define clst4 (list 1 2 3 4))
(set-cdr! (my-list-tail clst4 3) clst4)


;;
;; Constructors
;;

(test-begin "xcons")
(test-equal (cons elm1 elm0)      (xcons elm0 elm1))
(test-eq elm1             (car (xcons elm0 elm1)))
(test-eq elm0             (cdr (xcons elm0 elm1)))
(test-end "xcons")

(test-begin "cons* invalid forms")
(test-error (cons*))
(test-end "cons* invalid forms")
(test-begin "cons*")
(test-eq elm0                         (cons* elm0))
(test-equal (cons elm0 elm1)             (cons* elm0 elm1))
(test-equal (cons elm0 (cons elm1 elm2)) (cons* elm0 elm1 elm2))
(test-equal lst                        (cons* elm0 elm1 elm2 cdr3))
(test-assert (not (eq? lst                   (cons* elm0 elm1 elm2 cdr3))))
(test-assert (not (eq? cdr2 (my-list-tail    (cons* elm0 elm1 elm2 cdr3) 2))))
(test-assert (eq? cdr3 (my-list-tail    (cons* elm0 elm1 elm2 cdr3) 3)))
(test-equal '(1 2 3 4 5 6)               (cons* 1 2 3 '(4 5 6)))
(test-end "cons*")
(test-begin "cons* SRFI-1 examples")
(test-equal '(1 2 3 . 4) (cons* 1 2 3 4))
(test-equal 1            (cons* 1))
(test-end "cons* SRFI-1 examples")

(test-begin "make-list invalid forms")
(test-error (make-list #t))
(test-error (make-list -1))
(test-error (make-list 0 #t #t))
(test-end "make-list invalid forms")
(test-begin "make-list")
(define fill (if sigscheme?
                 (undef)
                 (error "filler value of make-list is unknown")))
(test-equal '()                        (make-list 0))
(test-equal (list fill)                (make-list 1))
(test-equal (list fill fill)           (make-list 2))
(test-equal (list fill fill fill)      (make-list 3))
(test-equal (list fill fill fill fill) (make-list 4))
(test-equal '()                        (make-list 0 elm0))
(test-equal (list elm0)                (make-list 1 elm0))
(test-equal (list elm0 elm0)           (make-list 2 elm0))
(test-equal (list elm0 elm0 elm0)      (make-list 3 elm0))
(test-equal (list elm0 elm0 elm0 elm0) (make-list 4 elm0))
(test-end "make-list")

(test-begin "list-tabulate invalid forms")
(test-error (list-tabulate 0))
(test-error (list-tabulate 0 number->string #t))
(test-error (list-tabulate 0 #t #t))
(test-error (list-tabulate 1 string->number))
(test-end "list-tabulate invalid forms")
(test-begin "list-tabulate")
(test-equal '()                (list-tabulate 0 number->string))
(test-equal '("0")             (list-tabulate 1 number->string))
(test-equal '("0" "1")         (list-tabulate 2 number->string))
(test-equal '("0" "1" "2")     (list-tabulate 3 number->string))
(test-equal '("0" "1" "2" "3") (list-tabulate 4 number->string))
(test-end "list-tabulate")
(test-begin "list-tabulate SRFI-1 examples")
(test-equal '(0 1 2 3) (list-tabulate 4 values))
(test-end "list-tabulate SRFI-1 examples")

(test-begin "list-copy invalid forms")
(test-error (list-copy))
(test-end "list-copy invalid forms")
(test-begin "list-copy")
(test-equal lst (list-copy lst))
(test-assert (not (eq? lst (list-copy lst))))
(test-assert (not (eq? (my-list-tail lst             1)
                       (my-list-tail (list-copy lst) 1))))
(test-assert (not (eq? (my-list-tail lst             2)
                       (my-list-tail (list-copy lst) 2))))
(test-assert (not (eq? (my-list-tail lst             9)
                       (my-list-tail (list-copy lst) 9))))
;; null terminator
(test-assert (eq? (my-list-tail lst             10)
                  (my-list-tail (list-copy lst) 10)))
(test-end "list-copy")

(test-begin "circular-list invalid forms")
(test-error (circular-list))
(test-end "circular-list invalid forms")
(test-begin "circular-list length 1")
(test-eq elm0 (car (my-list-tail (circular-list elm0) 0)))
(test-eq elm0 (car (my-list-tail (circular-list elm0) 1)))
(test-eq elm0 (car (my-list-tail (circular-list elm0) 2)))
(test-eq elm0 (car (my-list-tail (circular-list elm0) 3)))
(test-eq elm0 (car (my-list-tail (circular-list elm0) 4)))
(test-eq elm0 (car (my-list-tail (circular-list elm0) 5)))
(test-end "circular-list length 1")
(test-begin "circular-list length 2")
(test-eq elm0 (car (my-list-tail (circular-list elm0 elm1) 0)))
(test-eq elm1 (car (my-list-tail (circular-list elm0 elm1) 1)))
(test-eq elm0 (car (my-list-tail (circular-list elm0 elm1) 2)))
(test-eq elm1 (car (my-list-tail (circular-list elm0 elm1) 3)))
(test-eq elm0 (car (my-list-tail (circular-list elm0 elm1) 4)))
(test-eq elm1 (car (my-list-tail (circular-list elm0 elm1) 5)))
(test-end "circular-list length 2")
(test-begin "circular-list length 3")
(test-eq elm0 (car (my-list-tail (circular-list elm0 elm1 elm2) 0)))
(test-eq elm1 (car (my-list-tail (circular-list elm0 elm1 elm2) 1)))
(test-eq elm2 (car (my-list-tail (circular-list elm0 elm1 elm2) 2)))
(test-eq elm0 (car (my-list-tail (circular-list elm0 elm1 elm2) 3)))
(test-eq elm1 (car (my-list-tail (circular-list elm0 elm1 elm2) 4)))
(test-eq elm2 (car (my-list-tail (circular-list elm0 elm1 elm2) 5)))
(test-eq elm0 (car (my-list-tail (circular-list elm0 elm1 elm2) 6)))
(test-end "circular-list length 3")

(test-begin "iota invalid forms")
(test-error (iota))
(test-error (iota -1))
(test-error (iota -1 0 1))
(test-error (iota -1 0 1))
(test-error (iota 0 0 0 0))
(test-error (iota 1 0 0 0))
(test-end "iota invalid forms")
(test-begin "iota count only")
(test-equal '()           (iota 0))
(test-equal '(0)          (iota 1))
(test-equal '(0 1)        (iota 2))
(test-equal '(0 1 2)      (iota 3))
(test-equal '(0 1 2 3)    (iota 4))
(test-end "iota count only")
(test-begin "iota count and start")
(test-equal '()           (iota 0 2))
(test-equal '(2)          (iota 1 2))
(test-equal '(2 3)        (iota 2 2))
(test-equal '(2 3 4)      (iota 3 2))
(test-equal '(2 3 4 5)    (iota 4 2))
;; nagative start
(test-equal '()           (iota 0 -2))
(test-equal '(-2)         (iota 1 -2))
(test-equal '(-2 -1)      (iota 2 -2))
(test-equal '(-2 -1 0)    (iota 3 -2))
(test-equal '(-2 -1 0 1)  (iota 4 -2))
(test-end "iota count and start")
(test-begin "iota count, start and step")
(test-equal '()           (iota 0 2 3))
(test-equal '(2)          (iota 1 2 3))
(test-equal '(2 5)        (iota 2 2 3))
(test-equal '(2 5 8)      (iota 3 2 3))
(test-equal '(2 5 8 11)   (iota 4 2 3))
;; negative step
(test-equal '()           (iota 0 2 -3))
(test-equal '(2)          (iota 1 2 -3))
(test-equal '(2 -1)       (iota 2 2 -3))
(test-equal '(2 -1 -4)    (iota 3 2 -3))
(test-equal '(2 -1 -4 -7) (iota 4 2 -3))
;; zero step
(test-equal '()           (iota 0 2 0))
(test-equal '(2)          (iota 1 2 0))
(test-equal '(2 2)        (iota 2 2 0))
(test-equal '(2 2 2)      (iota 3 2 0))
(test-equal '(2 2 2 2)    (iota 4 2 0))
(test-end "iota count, start and step")

;;
;; Predicates
;;

;; proper-list?
(test-begin "proper-list? proper list")
(test-eq #t (proper-list? '()))
(test-eq #t (proper-list? '(1)))
(test-eq #t (proper-list? '(1 2)))
(test-eq #t (proper-list? '(1 2 3)))
(test-eq #t (proper-list? '(1 2 3 4)))
(test-end "proper-list? proper list")
(test-begin "proper-list? dotted list")
(test-eq #f (proper-list? 1))
(test-eq #f (proper-list? '(1 . 2)))
(test-eq #f (proper-list? '(1 2 . 3)))
(test-eq #f (proper-list? '(1 2 3 . 4)))
(test-eq #f (proper-list? '(1 2 3 4 . 5)))
(test-end "proper-list? dotted list")
(test-begin "proper-list? circular list")
(test-eq #f (proper-list? clst1))
(test-eq #f (proper-list? clst2))
(test-eq #f (proper-list? clst3))
(test-eq #f (proper-list? clst4))
(test-end "proper-list? circular list")
(test-begin "proper-list? all kind of Scheme objects")
(test-eq #f (proper-list? #f))
(test-eq #f (proper-list? #t))
(test-eq #t (proper-list? '()))
(if sigscheme?
    (begin
      (test-eq #f (proper-list? (eof)))
      (test-eq #f (proper-list? (undef)))))
(test-eq #f (proper-list? 0))
(test-eq #f (proper-list? 1))
(test-eq #f (proper-list? 3))
(test-eq #f (proper-list? -1))
(test-eq #f (proper-list? -3))
(test-eq #f (proper-list? 'symbol))
(test-eq #f (proper-list? 'SYMBOL))
(test-eq #f (proper-list? #\a))
(test-eq #f (proper-list? #\あ))
(test-eq #f (proper-list? ""))
(test-eq #f (proper-list? " "))
(test-eq #f (proper-list? "a"))
(test-eq #f (proper-list? "A"))
(test-eq #f (proper-list? "aBc12!"))
(test-eq #f (proper-list? "あ"))
(test-eq #f (proper-list? "あ0イう12!"))
(test-eq #f (proper-list? +))
(test-eq #f (proper-list? (lambda () #t)))

;; syntactic keywords should not be appeared as operand
(if sigscheme?
    (begin
      ;; pure syntactic keyword
      (test-error (proper-list? else))
      ;; expression keyword
      (test-argcheck-error (proper-list? do))))

(call-with-current-continuation
 (lambda (k)
   (test-eq #f (proper-list? k))))
(test-eq #f (proper-list? (current-output-port)))
(test-eq #f (proper-list? '(#t . #t)))
(test-eq #f (proper-list? (cons #t #t)))
(test-eq #t (proper-list? '(0 1 2)))
(test-eq #t (proper-list? (list 0 1 2)))
(test-eq #f (proper-list? '#()))
(test-eq #f (proper-list? (vector)))
(test-eq #f (proper-list? '#(0 1 2)))
(test-eq #f (proper-list? (vector 0 1 2)))
(test-end "proper-list? all kind of Scheme objects")

;; circular-list?
(test-begin "circular-list? proper list")
(test-eq #f (circular-list? '()))
(test-eq #f (circular-list? '(1)))
(test-eq #f (circular-list? '(1 2)))
(test-eq #f (circular-list? '(1 2 3)))
(test-eq #f (circular-list? '(1 2 3 4)))
