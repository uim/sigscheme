      (test-argcheck-error (circular-list? do))))

(call-with-current-continuation
 (lambda (k)
   (test-eq #f (circular-list? k))))
(test-eq #f (circular-list? (current-output-port)))
(test-eq #f (circular-list? '(#t . #t)))
(test-eq #f (circular-list? (cons #t #t)))
(test-eq #f (circular-list? '(0 1 2)))
(test-eq #f (circular-list? (list 0 1 2)))
(test-eq #f (circular-list? '#()))
(test-eq #f (circular-list? (vector)))
(test-eq #f (circular-list? '#(0 1 2)))
(test-eq #f (circular-list? (vector 0 1 2)))
(test-end "circular-list? all kind of Scheme objects")

