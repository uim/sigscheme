(test-begin "take freshly-allocated entire list")
;; SRFI-1: If the argument is a list of non-zero length, take is guaranteed to
;; return a freshly-allocated list, even in the case where the entire list is
;; taken, e.g. (take lis (length lis)).
(test-assert (not (eq?    lst (take lst (length lst)))))
(test-assert (equal? lst (take lst (length lst))))
(define find-pair
  (lambda (x lst)
    (let rec ((rest lst))
      (if (null? rest)
          #f
          (or (eq? x rest)
              (rec (cdr rest)))))))
;; Check uniqueness for each pair in the new list.
(test-assert (let rec ((rest (take lst (length lst))))
               (if (null? rest)
                   #t
                   (and (not (find-pair rest lst))
                        (rec (cdr rest))))))
(test-end "take freshly-allocated entire list")
(test-begin "take SRFI-1 examples")
(test-equal '(a b)   (take '(a b c d e) 2))
(test-equal '(1 2)   (take '(1 2 3 . d) 2))
