(test-begin "map SRFI-1 examples")
(test-equal '(b e h)
            (map cadr '((a b) (d e) (g h))))
(define expt
  (lambda (x y)
    (apply * (make-list y x))))
(test-equal '(1 4 27 256 3125)
            (map (lambda (n) (expt n n))
                 '(1 2 3 4 5)))
(test-equal '(5 7 9)
            (map + '(1 2 3) '(4 5 6)))
