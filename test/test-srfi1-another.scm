(test-begin "fold invalid forms")
(test-error (fold cons))
(test-error (fold cons '()))
(test-error (fold cons '#()))
(test-error (fold cons '(1) '#(2)))
(test-error (fold #\a '()))
(test-end "fold invalid forms")
(test-begin "fold single list")
(test-equal '()      (fold cons '() '()))
(test-equal '(1)     (fold cons '() '(1)))
(test-equal '(2 1)   (fold cons '() '(1 2)))
(test-equal '(3 2 1) (fold cons '() '(1 2 3)))
(test-end "fold single list")
(test-begin "fold 3 lists")
(test-equal "cCzbByaAxNIL"
            (fold string-append
                  "NIL"
                  '("a" "b" "c") '("A" "B" "C") '("x" "y" "z")))
;; unequal length
(test-equal "bByaAxNIL"
            (fold string-append
                  "NIL"
                  '("a" "b" "c") '("A" "B") '("x" "y" "z")))
(test-equal "NIL"
            (fold string-append
                  "NIL"
                  '("a" "b" "c") '() '("x" "y" "z")))
(test-end "fold 3 lists")
(test-begin "fold SRFI-1 examples")
;; Add up the elements of list.
(test-equal 15 (fold + 0 '(1 2 3 4 5)))
;; Reverse LST.
(test-equal (list elm9 elm8 elm7 elm6 elm5 elm4 elm3 elm2 elm1 elm0)
            (fold cons '() lst))
;; See APPEND-REVERSE.
(test-equal '(10 9 8 1 2 3)
            (let ((tail '(1 2 3))
                  (rev-head '(8 9 10)))
              (fold cons tail rev-head)))
;; How many symbols in list?
(test-equal 0
            (fold (lambda (x count) (if (symbol? x) (+ count 1) count))
                  0
                  lst))
(test-equal 3
            (fold (lambda (x count) (if (symbol? x) (+ count 1) count))
                  0
                  '(0 #\a a "a" b (0) c)))
;; Length of the longest string in list:
(test-equal 17
            (fold (lambda (s max-len) (max max-len (string-length s)))
                  0
                  '("" "string-append" "str" "SigScheme Project" "SRFI-1")))
;; unequal length lists
(test-equal '(c 3 b 2 a 1)
            (fold cons* '() '(a b c) '(1 2 3 4 5)))
(test-end "fold SRFI-1 examples")

