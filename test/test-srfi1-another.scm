(test-error (unfold null?     car cdr 1))
(test-equal '()            (unfold not-pair? car cdr 1))
(test-equal 1              (unfold not-pair? car cdr 1 values))
(test-equal '(1 2 3 4)     (unfold null?     car cdr '(1 2 3 4)))
(test-error (unfold null?     car cdr '(1 2 3 4 . 5)))
(test-equal '(1 2 3 4)     (unfold not-pair? car cdr '(1 2 3 4 . 5)))
(test-equal '(1 2 3 4 . 5) (unfold not-pair? car cdr '(1 2 3 4 . 5) values))
(test-end "unfold")
(test-begin "unfold SRFI-1 examples")
;; List of squares: 1^2 ... 10^2
(test-equal '(1 4 9 16 25 36 49 64 81 100)
            (unfold (lambda (x) (> x 10))
                    (lambda (x) (* x x))
                    (lambda (x) (+ x 1))
                    1))
;; Copy a proper list.
(test-assert (equal? lst (unfold null-list? car cdr lst)))
(test-assert (not (eq?    lst (unfold null-list? car cdr lst))))
;; Read current input port into a list of values.
(test-equal '((equal? lst (unfold null-list? car cdr lst)))
            (let ((p (open-input-string
                      "(equal? lst (unfold null-list? car cdr lst))")))
              (unfold eof-object? values (lambda (x) (read p)) (read p))))
;; Copy a possibly non-proper list:
(test-assert (equal? lst (unfold not-pair? car cdr lst values)))
(test-assert (not (eq?    lst (unfold not-pair? car cdr lst values))))
(let ((dlst (cons elm0 (cons elm1 (cons elm2 elm3)))))
  (test-assert (equal? dlst (unfold not-pair? car cdr dlst values)))
  (test-assert (not (eq?    dlst (unfold not-pair? car cdr dlst values)))))
;; Append HEAD onto TAIL:
(test-equal '(1 2 3 4 5 6)
            (let ((head '(1 2 3))
                  (tail '(4 5 6)))
              (unfold null-list? car cdr head
                      (lambda (x) tail))))
(test-end "unfold SRFI-1 examples")

