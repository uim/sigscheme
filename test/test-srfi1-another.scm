                                    (set! count (+ count 1))
                                    count)
                                  '(a b)))))
               (or (equal? result '(1 2))
                   (equal? result '(2 1)))))
(test-equal '(4 1 5 1)
            (map + '(3 1 4 1) (circular-list 1 0)))
(test-end "map SRFI-1 examples")

