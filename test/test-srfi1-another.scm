;;
;; Association lists
;;

(define alist-s '(("b" . 2) ("a" . 1) ("d" . 4) ("b" . 5) ("c" . 3)))
(define alist-n '((1 . a) (5 . e) (6 . f) (2 . b) (4 . d) (3 . c)
                  (4 . d) (3 . c) (7 . g) (6 . f) (5 . e) (7 . g)))

;; assoc
(test-begin "assoc (SRFI-1 extended) invalid forms")
(test-error (assoc "a" alist-s #\a))
(test-error (assoc "a" alist-s string=? values))
(test-end "assoc (SRFI-1 extended) invalid forms")
(test-begin "assoc (SRFI-1 extended)")
(test-equal '("b" . 2) (assoc "b" alist-s))
(test-equal '("a" . 1) (assoc "a" alist-s))
(test-equal '("d" . 4) (assoc "d" alist-s))
(test-equal '("c" . 3) (assoc "c" alist-s))
(test-assert (not (assoc "A" alist-s)))
(test-equal '("b" . 2) (assoc "b" alist-s string=?))
(test-equal '("a" . 1) (assoc "a" alist-s string=?))
(test-equal '("d" . 4) (assoc "d" alist-s string=?))
(test-equal '("c" . 3) (assoc "c" alist-s string=?))
(test-assert (not (assoc "A" alist-s string=?)))
(test-end "assoc (SRFI-1 extended)")

;; alist-cons
(test-begin "alist-cons")
(test-equal '(("A" . 1))              (alist-cons "A" 1 '()))
(test-equal (cons '("A" . 1) alist-s) (alist-cons "A" 1 alist-s))
(test-eq alist-s              (cdr (alist-cons "A" 1 alist-s)))
(test-end "alist-cons")

;; alist-copy
(test-begin "alist-copy")
(test-equal '()     (alist-copy '()))
(test-equal alist-s (alist-copy alist-s))
(test-assert (not (eq?      (list-ref alist-s              0)
                            (list-ref (alist-copy alist-s) 0))))
(test-assert (eq? (car (list-ref alist-s              0))
                  (car (list-ref (alist-copy alist-s) 0))))
(test-assert (eq? (cdr (list-ref alist-s              0))
                  (cdr (list-ref (alist-copy alist-s) 0))))
(test-assert (not (eq?      (list-ref alist-s              1)
                            (list-ref (alist-copy alist-s) 1))))
(test-assert (eq? (car (list-ref alist-s              1))
                  (car (list-ref (alist-copy alist-s) 1))))
(test-assert (eq? (cdr (list-ref alist-s              1))
                  (cdr (list-ref (alist-copy alist-s) 1))))
(test-assert (not (eq?      (list-ref alist-s              2)
                            (list-ref (alist-copy alist-s) 2))))
(test-assert (eq? (car (list-ref alist-s              2))
                  (car (list-ref (alist-copy alist-s) 2))))
(test-assert (eq? (cdr (list-ref alist-s              2))
                  (cdr (list-ref (alist-copy alist-s) 2))))
(test-end "alist-copy")

;; alist-delete
(test-begin "alist-delete invalid forms")
(test-error (alist-delete "A" '#()))
(test-error (alist-delete "A" '(("a" . 1)) #\a))
(test-error (alist-delete #\a '(("a" . 1)) string=?))
(test-end "alist-delete invalid forms")
(test-begin "alist-delete")
(test-equal '() (alist-delete "A" '()))
(test-equal '() (alist-delete "A" '() string=?))
(test-equal '(("b" . 2) ("a" . 1) ("d" . 4) ("b" . 5) ("c" . 3))
            (alist-delete "A" alist-s))
(test-equal '(("b" . 2) ("d" . 4) ("b" . 5) ("c" . 3))
            (alist-delete "a" alist-s))
(test-equal '(("a" . 1) ("d" . 4) ("c" . 3))
            (alist-delete "b" alist-s))
(test-equal '(("a" . 1) ("d" . 4) ("c" . 3))
            (alist-delete "b" alist-s string=?))
(test-equal '((1 . a) (5 . e) (6 . f) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (7 . g) (6 . f) (5 . e) (7 . g))
            (alist-delete -1 alist-n))
(test-equal '((1 . a) (5 . e) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (7 . g) (5 . e) (7 . g))
            (alist-delete 6 alist-n))
(test-equal '((1 . a) (5 . e) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (7 . g) (5 . e) (7 . g))
            (alist-delete 6 alist-n =))
(test-end "alist-delete")
(test-begin "alist-delete SRFI-1 examples")
(test-equal '((1 . a) (5 . e) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (5 . e))
            (alist-delete 5 alist-n <))
(test-end "alist-delete SRFI-1 examples")

;; alist-delete!
(test-begin "alist-delete! invalid forms")
(test-error (alist-delete! "A" (vector)))
(test-error (alist-delete! "A" (list (cons "a" 1)) #\a))
(test-error (alist-delete! #\a (list (cons "a" 1)) string=?))
(test-end "alist-delete! invalid forms")
(test-begin "alist-delete!")
(test-equal '() (alist-delete! "A" '()))
(test-equal '() (alist-delete! "A" '() string=?))
(test-equal '(("b" . 2) ("a" . 1) ("d" . 4) ("b" . 5) ("c" . 3))
            (alist-delete! "A" (alist-copy alist-s)))
(test-equal '(("b" . 2) ("d" . 4) ("b" . 5) ("c" . 3))
            (alist-delete! "a" (alist-copy alist-s)))
(test-equal '(("a" . 1) ("d" . 4) ("c" . 3))
            (alist-delete! "b" (alist-copy alist-s)))
(test-equal '(("a" . 1) ("d" . 4) ("c" . 3))
            (alist-delete! "b" (alist-copy alist-s) string=?))
(test-equal '((1 . a) (5 . e) (6 . f) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (7 . g) (6 . f) (5 . e) (7 . g))
            (alist-delete! -1 (alist-copy alist-n)))
(test-equal '((1 . a) (5 . e) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (7 . g) (5 . e) (7 . g))
            (alist-delete! 6 (alist-copy alist-n)))
(test-equal '((1 . a) (5 . e) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (7 . g) (5 . e) (7 . g))
            (alist-delete! 6 (alist-copy alist-n) =))
(test-end "alist-delete!")
(test-begin "alist-delete! SRFI-1 examples")
(test-equal '((1 . a) (5 . e) (2 . b) (4 . d) (3 . c)
              (4 . d) (3 . c) (5 . e))
            (alist-delete! 5 (alist-copy alist-n) <))
(test-end "alist-delete! SRFI-1 examples")


