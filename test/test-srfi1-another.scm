(test-eq #f (null-list? '(1)))
(test-eq #f (null-list? '(1 2)))
(test-eq #f (null-list? '(1 2 3)))
(test-eq #f (null-list? '(1 2 3 4)))
(test-end "null-list? proper list")
;; SRFI-1: List is a proper or circular list. It is an error to pass this
;; procedure a value which is not a proper or circular list.
(test-begin "null-list? dotted list")
(if sigscheme?
    (begin
      ;; SigScheme (SRFI-1 reference implementation) specific behavior
      (test-error (null-list? 1))
      (test-eq #f         (null-list? '(1 . 2)))
      (test-eq #f         (null-list? '(1 2 . 3)))
      (test-eq #f         (null-list? '(1 2 3 . 4)))
      (test-eq #f         (null-list? '(1 2 3 4 . 5)))))
(test-end "null-list? dotted list")
(test-begin "null-list? circular list")
(test-eq #f (null-list? clst1))
(test-eq #f (null-list? clst2))
(test-eq #f (null-list? clst3))
(test-eq #f (null-list? clst4))
(test-end "null-list? circular list")

