(test-begin "circular-list? all kind of Scheme objects")
(test-eq #f (circular-list? #f))
(test-eq #f (circular-list? #t))
(test-eq #f (circular-list? '()))
(if sigscheme?
    (begin
      (test-eq #f (circular-list? (eof)))
      (test-eq #f (circular-list? (undef)))))
(test-eq #f (circular-list? 0))
(test-eq #f (circular-list? 1))
(test-eq #f (circular-list? 3))
(test-eq #f (circular-list? -1))
(test-eq #f (circular-list? -3))
(test-eq #f (circular-list? 'symbol))
(test-eq #f (circular-list? 'SYMBOL))
(test-eq #f (circular-list? #\a))
(test-eq #f (circular-list? #\あ))
(test-eq #f (circular-list? ""))
(test-eq #f (circular-list? " "))
(test-eq #f (circular-list? "a"))
(test-eq #f (circular-list? "A"))
(test-eq #f (circular-list? "aBc12!"))
(test-eq #f (circular-list? "あ"))
(test-eq #f (circular-list? "あ0イう12!"))
(test-eq #f (circular-list? +))
(test-eq #f (circular-list? (lambda () #t)))

;; syntactic keywords should not be appeared as operand
(if sigscheme?
    (begin
      ;; pure syntactic keyword
      (test-error (circular-list? else))
