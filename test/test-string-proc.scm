(test-begin "%%string-reconstruct!")
(test-error (%%string-reconstruct! ""))
(test-error (%%string-reconstruct! "const str"))
(test-error (%%string-reconstruct! "あaう"))
(test-equal 0 (string-length (string-copy "")))
(test-equal 9 (string-length (string-copy "const str")))
(test-equal 3 (string-length (string-copy "あaう")))
(test-equal 0 (string-length (with-char-codec "ISO-8859-1"
                               (lambda ()
                                 (%%string-reconstruct!
                                  (string-copy ""))))))
(test-equal 9 (string-length (with-char-codec "ISO-8859-1"
                               (lambda ()
                                 (%%string-reconstruct!
                                  (string-copy "const str"))))))
(test-equal 7 (string-length (with-char-codec "ISO-8859-1"
                               (lambda ()
                                 (%%string-reconstruct!
                                  (string-copy "あaう"))))))
(let ((byte-str (with-char-codec "ISO-8859-1"
                  (lambda ()
                    (%%string-reconstruct!
                     (string-copy "あaう"))))))
  (test-equal 7 (string-length byte-str))
  ;; reconstruct as UTF-8 string
  (test-equal 3 (string-length (%%string-reconstruct! byte-str))))
(test-end "%%string-reconstruct!")

