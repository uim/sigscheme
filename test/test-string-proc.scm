(test-begin "list->string improper lists")
(test-error (list->string '(#\あ #\a #\う . #\b)))
;; circular lists
(define clst1 (list #\a))
(set-cdr! clst1 clst1)
(define clst2 (list #\a #\b))
(set-cdr! (list-tail clst2 1) clst2)
(define clst3 (list #\a #\b #\c))
(set-cdr! (list-tail clst3 2) clst3)
(define clst4 (list #\a #\b #\c #\d))
(set-cdr! (list-tail clst4 3) clst4)
(if (and sigscheme?
         (provided? "strict-argcheck"))
    (begin
      (test-error (list->string clst1))
      (test-error (list->string clst2))
      (test-error (list->string clst3))
      (test-error (list->string clst4))))
(test-end "list->string improper lists")

