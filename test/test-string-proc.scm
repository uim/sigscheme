(require-extension (sscm-ext))

(require-extension (srfi 64))

(if (and sigscheme?
         (not (symbol-bound? 'make-string)))
    (test-skip-file "non-core string procedures of R5RS is not enabled"))

(if (not (provided? "r6rs-chars"))
    (test-skip-file "R6RS characters is not enabled"))

(test-begin "test-string-proc")
(define cp string-copy)

(define mutable?
  (if sigscheme?
      %%string-mutable?
      (lambda (s) #t)))

(define pair-mutable?
  (if sigscheme?
      %%pair-mutable?
      (lambda (kons) #t)))

;;
;; All procedures that take a string as argument are tested with
;; both immutable and mutable string.
;;
;; See "3.4 Storage model" of R5RS
;;


(test-begin "make-string invalid forms")
(test-error (make-string -2))
(test-error (make-string -1))
(test-error (make-string -2 #\a))
(test-error (make-string -1 #\a))
(test-error (make-string #\a))
(test-error (make-string 1 32))
(test-end "make-string invalid forms")
(test-begin "make-string")
(test-equal ""         (make-string 0))
(test-equal "?"        (make-string 1))
(test-equal "??"       (make-string 2))
(test-equal "???"      (make-string 3))
(test-equal ""         (make-string 0 #\a))
(test-equal "a"        (make-string 1 #\a))
(test-equal "aa"       (make-string 2 #\a))
(test-equal "aaa"      (make-string 3 #\a))
(test-equal ""         (make-string 0 #\あ))
(test-equal "あ"       (make-string 1 #\あ))
(test-equal "ああ"     (make-string 2 #\あ))
(test-equal "あああ"   (make-string 3 #\あ))
(test-end "make-string")
(test-begin "make-string NUL filler")
(test-equal ""         (make-string 0 #\nul))
(if (and sigscheme?
         (not (provided? "null-capable-string")))
    (begin
      (test-error (make-string 1 #\nul))
      (test-error (make-string 2 #\nul))
      (test-error (make-string 3 #\nul))))
(test-end "make-string NUL filler")

(test-begin "string invalid forms")
(test-error (string #t))
(test-error (string "a"))
(test-end "string invalid forms")
(test-begin "string")
(test-equal ""         (string))
(test-equal "a"        (string #\a))
(test-equal "ab"       (string #\a #\b))
(test-equal "あ"       (string #\あ))
(test-equal "あう"     (string #\あ #\う))
(test-equal "aあb"     (string #\a #\あ #\b))
(test-equal "あaう"    (string #\あ #\a #\う))
(test-equal "aあbう"   (string #\a #\あ #\b #\う))
(test-equal "あaうb"   (string #\あ #\a #\う #\b))
(test-end "string")
(test-begin "string mutability")
(test-assert (mutable?  (string)))
(test-assert (mutable?  (string #\a)))
(test-assert (mutable?  (string #\a #\b)))
(test-assert (mutable?  (string #\あ)))
(test-assert (mutable?  (string #\あ #\う)))
(test-assert (mutable?  (string #\a #\あ #\b)))
(test-assert (mutable?  (string #\あ #\a #\う)))
(test-assert (mutable?  (string #\a #\あ #\b #\う)))
(test-assert (mutable?  (string #\あ #\a #\う #\b)))
(test-end "string mutability")
(test-begin "string with NUL args")
(if (and sigscheme?
         (not (provided? "null-capable-string")))
    (begin
      (test-error (string #\nul))
      (test-error (string #\a #\nul))
      (test-error (string #\nul #\a))
      (test-error (string #\a #\nul #\a))))
(test-end "string with NUL args")

(test-begin "string-ref invalid forms")
(test-error (string-ref #\a 0))
(test-error (string-ref "a" #\1))
(test-end "string-ref invalid forms")
(test-begin "string-ref immutable")
(test-error (string-ref "" -2))
(test-error (string-ref "" -1))
(test-error (string-ref "" 0))
(test-error (string-ref "" 1))
(test-error (string-ref "" 2))
(test-error (string-ref "a" -2))
(test-error (string-ref "a" -1))
(test-equal #\a        (string-ref "a" 0))
(test-error (string-ref "a" 1))
(test-error (string-ref "a" 2))
(test-error (string-ref "ab" -2))
(test-error (string-ref "ab" -1))
(test-equal #\a        (string-ref "ab" 0))
(test-equal #\b        (string-ref "ab" 1))
(test-error (string-ref "ab" 2))
(test-error (string-ref "ab" 3))
(test-error (string-ref "あ" -2))
(test-error (string-ref "あ" -1))
(test-equal #\あ       (string-ref "あ" 0))
(test-error (string-ref "あ" 1))
(test-error (string-ref "あ" 2))
(test-error (string-ref "あう" -2))
(test-error (string-ref "あう" -1))
(test-equal #\あ       (string-ref "あう" 0))
(test-equal #\う       (string-ref "あう" 1))
(test-error (string-ref "あう" 2))
(test-error (string-ref "あう" 3))
(test-error (string-ref "aあb" -2))
(test-error (string-ref "aあb" -1))
(test-equal #\a        (string-ref "aあb" 0))
(test-equal #\あ       (string-ref "aあb" 1))
(test-equal #\b        (string-ref "aあb" 2))
(test-error (string-ref "aあb" 3))
(test-error (string-ref "aあb" 4))
(test-error (string-ref "あaう" -2))
(test-error (string-ref "あaう" -1))
(test-equal #\あ       (string-ref "あaう" 0))
(test-equal #\a        (string-ref "あaう" 1))
(test-equal #\う       (string-ref "あaう" 2))
(test-error (string-ref "あaう" 3))
(test-error (string-ref "あaう" 4))
(test-error (string-ref "aあbう" -2))
(test-error (string-ref "aあbう" -1))
(test-equal #\a        (string-ref "aあbう" 0))
(test-equal #\あ       (string-ref "aあbう" 1))
(test-equal #\b        (string-ref "aあbう" 2))
(test-equal #\う       (string-ref "aあbう" 3))
(test-error (string-ref "aあbう" 4))
(test-error (string-ref "aあbう" 5))
(test-error (string-ref "あaうb" -2))
(test-error (string-ref "あaうb" -1))
(test-equal #\あ       (string-ref "あaうb" 0))
(test-equal #\a        (string-ref "あaうb" 1))
(test-equal #\う       (string-ref "あaうb" 2))
(test-equal #\b        (string-ref "あaうb" 3))
(test-error (string-ref "あaうb" 4))
(test-error (string-ref "あaうb" 5))
(test-end "string-ref immutable")
(test-begin "string-ref mutable")
(test-error (string-ref (cp "") -2))
(test-error (string-ref (cp "") -1))
(test-error (string-ref (cp "") 0))
(test-error (string-ref (cp "") 1))
(test-error (string-ref (cp "") 2))
(test-error (string-ref (cp "a") -2))
(test-error (string-ref (cp "a") -1))
(test-equal #\a        (string-ref (cp "a") 0))
(test-error (string-ref (cp "a") 1))
(test-error (string-ref (cp "a") 2))
(test-error (string-ref (cp "ab") -2))
(test-error (string-ref (cp "ab") -1))
(test-equal #\a        (string-ref (cp "ab") 0))
(test-equal #\b        (string-ref (cp "ab") 1))
(test-error (string-ref (cp "ab") 2))
(test-error (string-ref (cp "ab") 3))
(test-error (string-ref (cp "あ") -2))
(test-error (string-ref (cp "あ") -1))
(test-equal #\あ       (string-ref (cp "あ") 0))
(test-error (string-ref (cp "あ") 1))
(test-error (string-ref (cp "あ") 2))
(test-error (string-ref (cp "あう") -2))
(test-error (string-ref (cp "あう") -1))
(test-equal #\あ       (string-ref (cp "あう") 0))
(test-equal #\う       (string-ref (cp "あう") 1))
(test-error (string-ref (cp "あう") 2))
(test-error (string-ref (cp "あう") 3))
(test-error (string-ref (cp "aあb") -2))
(test-error (string-ref (cp "aあb") -1))
(test-equal #\a        (string-ref (cp "aあb") 0))
(test-equal #\あ       (string-ref (cp "aあb") 1))
(test-equal #\b        (string-ref (cp "aあb") 2))
(test-error (string-ref (cp "aあb") 3))
(test-error (string-ref (cp "aあb") 4))
(test-error (string-ref (cp "あaう") -2))
(test-error (string-ref (cp "あaう") -1))
(test-equal #\あ       (string-ref (cp "あaう") 0))
(test-equal #\a        (string-ref (cp "あaう") 1))
(test-equal #\う       (string-ref (cp "あaう") 2))
(test-error (string-ref (cp "あaう") 3))
(test-error (string-ref (cp "あaう") 4))
(test-error (string-ref (cp "aあbう") -2))
(test-error (string-ref (cp "aあbう") -1))
(test-equal #\a        (string-ref (cp "aあbう") 0))
(test-equal #\あ       (string-ref (cp "aあbう") 1))
(test-equal #\b        (string-ref (cp "aあbう") 2))
(test-equal #\う       (string-ref (cp "aあbう") 3))
(test-error (string-ref (cp "aあbう") 4))
(test-error (string-ref (cp "aあbう") 5))
(test-error (string-ref (cp "あaうb") -2))
(test-error (string-ref (cp "あaうb") -1))
(test-equal #\あ       (string-ref (cp "あaうb") 0))
(test-equal #\a        (string-ref (cp "あaうb") 1))
(test-equal #\う       (string-ref (cp "あaうb") 2))
(test-equal #\b        (string-ref (cp "あaうb") 3))
(test-error (string-ref (cp "あaうb") 4))
(test-error (string-ref (cp "あaうb") 5))
(test-end "string-ref mutable")

