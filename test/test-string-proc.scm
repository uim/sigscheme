(define my-string-fill!
  (lambda (str ch)
    (string-fill! str ch)
    str))
(test-begin "string-fill! mutable")
(test-equal (undef)              (string-fill!    (cp "a") #\z))
(test-equal ""                   (my-string-fill! (cp "") #\z))
