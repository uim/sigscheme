(define my-string-set!
  (lambda (str k ch)
    (string-set! str k ch)
    str))
(test-begin "string-set! mutable")
(test-equal (undef)    (string-set! (cp "a") 0 #\z))
(test-error (my-string-set! (cp "") -2 #\z))
(test-error (my-string-set! (cp "") -1 #\z))
(test-error (my-string-set! (cp "") 0 #\z))
(test-error (my-string-set! (cp "") 1 #\z))
(test-error (my-string-set! (cp "") 2 #\z))
(test-error (my-string-set! (cp "a") -2 #\z))
(test-error (my-string-set! (cp "a") -1 #\z))
(test-equal "z"        (my-string-set! (cp "a") 0 #\z))
(test-error (my-string-set! (cp "a") 1 #\z))
(test-error (my-string-set! (cp "a") 2 #\z))
(test-error (my-string-set! (cp "ab") -2 #\z))
(test-error (my-string-set! (cp "ab") -1 #\z))
(test-equal "zb"       (my-string-set! (cp "ab") 0 #\z))
(test-equal "az"       (my-string-set! (cp "ab") 1 #\z))
(test-error (my-string-set! (cp "ab") 2 #\z))
(test-error (my-string-set! (cp "ab") 3 #\z))
(test-error (my-string-set! (cp "あ") -2 #\z))
(test-error (my-string-set! (cp "あ") -1 #\z))
(test-equal "z"        (my-string-set! (cp "あ") 0 #\z))
(test-error (my-string-set! (cp "あ") 1 #\z))
(test-error (my-string-set! (cp "あ") 2 #\z))
(test-error (my-string-set! (cp "あう") -2 #\z))
(test-error (my-string-set! (cp "あう") -1 #\z))
(test-equal "zう"      (my-string-set! (cp "あう") 0 #\z))
(test-equal "あz"      (my-string-set! (cp "あう") 1 #\z))
(test-error (my-string-set! (cp "あう") 2 #\z))
(test-error (my-string-set! (cp "あう") 3 #\z))
(test-error (my-string-set! (cp "aあb") -2 #\z))
(test-error (my-string-set! (cp "aあb") -1 #\z))
(test-equal "zあb"     (my-string-set! (cp "aあb") 0 #\z))
(test-equal "azb"      (my-string-set! (cp "aあb") 1 #\z))
(test-equal "aあz"     (my-string-set! (cp "aあb") 2 #\z))
(test-error (my-string-set! (cp "aあb") 3 #\z))
(test-error (my-string-set! (cp "aあb") 4 #\z))
(test-error (my-string-set! (cp "あaう") -2 #\z))
(test-error (my-string-set! (cp "あaう") -1 #\z))
(test-equal "zaう"     (my-string-set! (cp "あaう") 0 #\z))
(test-equal "あzう"    (my-string-set! (cp "あaう") 1 #\z))
(test-equal "あaz"     (my-string-set! (cp "あaう") 2 #\z))
(test-error (my-string-set! (cp "あaう") 3 #\z))
(test-error (my-string-set! (cp "あaう") 4 #\z))
(test-error (my-string-set! (cp "aあbう") -2 #\z))
(test-error (my-string-set! (cp "aあbう") -1 #\z))
(test-equal "zあbう"   (my-string-set! (cp "aあbう") 0 #\z))
(test-equal "azbう"    (my-string-set! (cp "aあbう") 1 #\z))
(test-equal "aあzう"   (my-string-set! (cp "aあbう") 2 #\z))
(test-equal "aあbz"    (my-string-set! (cp "aあbう") 3 #\z))
(test-error (my-string-set! (cp "aあbう") 4 #\z))
(test-error (my-string-set! (cp "aあbう") 5 #\z))
(test-error (my-string-set! (cp "あaうb") -2 #\z))
(test-error (my-string-set! (cp "あaうb") -1 #\z))
(test-equal "zaうb"    (my-string-set! (cp "あaうb") 0 #\z))
(test-equal "あzうb"   (my-string-set! (cp "あaうb") 1 #\z))
(test-equal "あazb"    (my-string-set! (cp "あaうb") 2 #\z))
(test-equal "あaうz"   (my-string-set! (cp "あaうb") 3 #\z))
(test-error (my-string-set! (cp "あaうb") 4 #\z))
(test-error (my-string-set! (cp "あaうb") 5 #\z))
(test-end "string-set! mutable")
